[Desktop Entry]
Version=1.0
Type=Application
Name=AURA Browser
Comment=Surf the web with Firefox ESR
Exec=firefox-esr %u
Icon=aura-browser
Terminal=false
Categories=Network;WebBrowser;
StartupNotify=true
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
