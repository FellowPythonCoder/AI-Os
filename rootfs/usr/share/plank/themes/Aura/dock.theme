# AURA OS — Plank dock theme (glassy midnight blue)
[PlankTheme]
TopRoundness=16
BottomRoundness=16
LineWidth=1
OuterStrokeColor=255;;255;;255;;80
FillStartColor=22;;42;;78;;205
FillEndColor=11;;23;;47;;195
InnerStrokeColor=140;;180;;240;;70

[PlankDockTheme]
HorizPadding=8
TopPadding=5
BottomPadding=5
ItemPadding=3
IndicatorSize=6
IconShadowSize=8
UrgentBounceHeight=1.666666
LaunchBounceHeight=0.625
FadeOpacity=1
ClickTime=300
UrgentBounceTime=600
LaunchBounceTime=600
ActiveTime=300
SlideTime=300
FadeTime=250
HideTime=250
GlowSize=30
GlowTime=10000
GlowPulseTime=2000
BadgeColor=47;;127;;224;;255
