# AURA OS — Plank dock theme (AURA Liquid Glass floating blue shelf)
# Palette: Midnight Navy #071426, Deep Ocean #0B2345, AURA Blue #1677FF,
#          Electric Cyan #55D6FF, Frosted White #F4F9FF
[PlankTheme]
TopRoundness=20
BottomRoundness=20
LineWidth=1
OuterStrokeColor=85;;214;;255;;105
FillStartColor=11;;35;;69;;208
FillEndColor=7;;20;;38;;226
InnerStrokeColor=244;;249;;255;;72

[PlankDockTheme]
HorizPadding=10
TopPadding=6
BottomPadding=7
ItemPadding=4
IndicatorSize=6
IconShadowSize=9
UrgentBounceHeight=1.666666
LaunchBounceHeight=0.625
FadeOpacity=1
ClickTime=280
UrgentBounceTime=550
LaunchBounceTime=550
ActiveTime=280
SlideTime=260
FadeTime=220
HideTime=220
GlowSize=32
GlowTime=10000
GlowPulseTime=2000
BadgeColor=22;;119;;255;;255
