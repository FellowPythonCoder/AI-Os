# AURA OS Plymouth boot splash.
# Assets (logo.png, background.png, bar-*.png) are rendered at build/install
# time by /usr/share/aura/render-boot-assets.sh from the SVG logo + wallpaper.

Window.SetBackgroundTopColor (0.02, 0.05, 0.13);
Window.SetBackgroundBottomColor (0.04, 0.10, 0.24);

# --- wallpaper background, scaled to cover the screen -----------------------
bg_image = Image("background.png");
if (bg_image) {
    scale_x = Window.GetWidth() / bg_image.GetWidth();
    scale_y = Window.GetHeight() / bg_image.GetHeight();
    scale = Math.Max(scale_x, scale_y);
    bg_sprite = Sprite(bg_image);
    bg_sprite.SetScale(scale, scale);
    bg_sprite.SetPosition(
        Window.GetX() + (Window.GetWidth() - bg_image.GetWidth() * scale) / 2,
        Window.GetY() + (Window.GetHeight() - bg_image.GetHeight() * scale) / 2,
        -10);
    bg_sprite.SetOpacity(0.55);
}

# --- mountain logo, gently pulsing ------------------------------------------
logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);
logo_x = Window.GetX() + Window.GetWidth() / 2 - logo_image.GetWidth() / 2;
logo_y = Window.GetY() + Window.GetHeight() * 0.30 - logo_image.GetHeight() / 2;
logo_sprite.SetPosition(logo_x, logo_y, 10);

# --- progress bar ------------------------------------------------------------
bar_w = Math.Min(360, Window.GetWidth() * 0.4);
bar_x = Window.GetX() + (Window.GetWidth() - bar_w) / 2;
bar_y = Window.GetY() + Window.GetHeight() * 0.30 + logo_image.GetHeight() / 2 + 42;

bar_bg_image = Image("bar-bg.png");
bar_bg_sprite = Sprite(bar_bg_image);
bar_bg_sprite.SetScale(bar_w / bar_bg_image.GetWidth(), 1);
bar_bg_sprite.SetPosition(bar_x, bar_y, 10);
bar_bg_sprite.SetOpacity(0.5);

bar_fg_image = Image("bar-fg.png");
bar_fg_sprite = Sprite(bar_fg_image);
bar_fg_sprite.SetPosition(bar_x, bar_y, 11);

# --- status message ------------------------------------------------------------
message_sprite = Sprite();
message_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2,
                           bar_y + 30, 10);

fun message_callback (text) {
    msg = Image.Text(text, 0.85, 0.92, 1.0);
    if (msg) {
        message_sprite.SetImage(msg);
        message_sprite.SetX(Window.GetX() + (Window.GetWidth() - msg.GetWidth()) / 2);
    }
}
Plymouth.SetMessageFunction(message_callback);

# --- animation -----------------------------------------------------------------
progress = 0;
fun refresh_callback () {
    progress += 0.0009;
    if (progress > 1) progress = 1;

    pulse = 0.86 + 0.14 * Math.Sin(Plymouth.GetTime() * 2.2);
    logo_sprite.SetOpacity(pulse);

    w = Math.Max(1, bar_w * progress);
    bar_fg_sprite.SetScale(w / bar_fg_image.GetWidth(), 1);
}
Plymouth.SetRefreshFunction(refresh_callback);

fun boot_progress_callback (duration, percent) {
    if (percent > progress) progress = percent;
}
Plymouth.SetBootProgressFunction(boot_progress_callback);

# --- password / question prompts (disk encryption etc.) ------------------------
prompt_sprite = Sprite();
entry_sprite = Sprite();
fun display_password_callback (prompt, bullets) {
    prompt_img = Image.Text(prompt, 0.9, 0.95, 1.0);
    prompt_sprite.SetImage(prompt_img);
    prompt_sprite.SetPosition(
        Window.GetX() + (Window.GetWidth() - prompt_img.GetWidth()) / 2, bar_y - 40, 20);
    bullet_text = "";
    for (i = 0; i < bullets; i++) bullet_text += "*";
    entry_img = Image.Text(bullet_text, 0.6, 0.85, 1.0);
    entry_sprite.SetImage(entry_img);
    entry_sprite.SetPosition(
        Window.GetX() + (Window.GetWidth() - entry_img.GetWidth()) / 2, bar_y + 8, 20);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_password_callback);
