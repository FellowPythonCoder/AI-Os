#!/usr/bin/env python3
"""
AURA Notes — fast, searchable notes stored as plain Markdown files in
~/Notes. Your words stay yours: no database, no lock-in.
"""
import os
import re
import sys
import time

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Pango  # noqa: E402

NOTES_DIR = os.path.expanduser("~/Notes")

STARTER = """# Welcome to AURA Notes 🏔

Everything you write here is saved automatically as a plain **Markdown**
file in your `~/Notes` folder — open them with any text editor, forever.

## Things to try

- Click **＋ New** to start a note
- Use the **search box** to filter instantly
- Write in Markdown: `# headings`, `**bold**`, `- lists`
- Toggle **Preview** to see it rendered
- Rename a note by editing its first `# heading`

Your notes sync beautifully with a shared UTM folder, so the same files
sit on your Mac desktop too.
"""


def md_to_pango(text):
    """Tiny Markdown → Pango markup converter (headings, emphasis, lists, code)."""
    out = []
    for line in text.splitlines():
        e = GLib.markup_escape_text(line)
        e = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", e)
        e = re.sub(r"(?<!\*)\*([^*\n]+?)\*(?!\*)", r"<i>\1</i>", e)
        e = re.sub(r"`([^`]+?)`", r'<tt background="#35507e"> \1 </tt>', e)
        if line.startswith("# "):
            out.append(f'<span size="x-large" weight="bold">{e[2:]}</span>')
        elif line.startswith("## "):
            out.append(f'<span size="large" weight="bold">{e[3:]}</span>')
        elif line.startswith("### "):
            out.append(f'<span weight="bold">{e[4:]}</span>')
        elif line.lstrip().startswith(("- ", "* ")):
            out.append("•  " + e.lstrip()[2:])
        elif line.strip() == "---":
            out.append("─" * 40)
        else:
            out.append(e)
    return "\n".join(out)


class Notes(Gtk.Window):
    def __init__(self):
        super().__init__(title="AURA Notes")
        self.set_default_size(900, 600)
        try:
            self.set_icon_name("aura-notes")
        except Exception:
            pass
        os.makedirs(NOTES_DIR, exist_ok=True)
        if not any(f.endswith(".md") for f in os.listdir(NOTES_DIR)):
            with open(os.path.join(NOTES_DIR, "welcome-to-aura-notes.md"),
                      "w", encoding="utf-8") as fh:
                fh.write(STARTER)

        self.current = None
        self.save_timer = None
        self.loading = False

        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        paned.set_position(270)
        self.add(paned)

        # ---- left: search + list
        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        left.set_border_width(8)
        bar = Gtk.Box(spacing=6)
        self.search = Gtk.SearchEntry(placeholder_text="Search notes…")
        self.search.connect("search-changed", lambda *_: self.refresh_list())
        bar.pack_start(self.search, True, True, 0)
        b_new = Gtk.Button(label="＋ New")
        b_new.get_style_context().add_class("suggested-action")
        b_new.connect("clicked", self.new_note)
        bar.pack_start(b_new, False, False, 0)
        left.pack_start(bar, False, False, 0)

        self.listbox = Gtk.ListBox()
        self.listbox.connect("row-selected", self.on_select)
        sw = Gtk.ScrolledWindow()
        sw.add(self.listbox)
        left.pack_start(sw, True, True, 0)

        b_del = Gtk.Button(label="Delete note")
        b_del.get_style_context().add_class("destructive-action")
        b_del.connect("clicked", self.delete_note)
        left.pack_start(b_del, False, False, 0)
        paned.add1(left)

        # ---- right: editor / preview
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        right.set_border_width(8)
        top = Gtk.Box(spacing=6)
        self.title_lbl = Gtk.Label(label="")
        self.title_lbl.set_xalign(0)
        self.title_lbl.get_style_context().add_class("dim-label")
        top.pack_start(self.title_lbl, True, True, 0)
        self.btn_preview = Gtk.ToggleButton(label="Preview")
        self.btn_preview.connect("toggled", self.toggle_preview)
        top.pack_start(self.btn_preview, False, False, 0)
        right.pack_start(top, False, False, 0)

        self.stack = Gtk.Stack()
        self.buffer = Gtk.TextBuffer()
        self.buffer.connect("changed", self.on_edited)
        editor = Gtk.TextView(buffer=self.buffer)
        editor.set_wrap_mode(Gtk.WrapMode.WORD)
        editor.set_monospace(True)
        editor.set_left_margin(10)
        editor.set_right_margin(10)
        editor.set_top_margin(8)
        esw = Gtk.ScrolledWindow()
        esw.add(editor)
        self.stack.add_named(esw, "edit")

        self.preview = Gtk.Label()
        self.preview.set_xalign(0)
        self.preview.set_yalign(0)
        self.preview.set_line_wrap(True)
        self.preview.set_line_wrap_mode(Pango.WrapMode.WORD)
        self.preview.set_selectable(True)
        self.preview.set_margin_start(12)
        self.preview.set_margin_end(12)
        self.preview.set_margin_top(8)
        psw = Gtk.ScrolledWindow()
        psw.add(self.preview)
        self.stack.add_named(psw, "preview")
        right.pack_start(self.stack, True, True, 0)

        self.status = Gtk.Label()
        self.status.set_xalign(0)
        self.status.get_style_context().add_class("dim-label")
        right.pack_start(self.status, False, False, 0)
        paned.add2(right)

        self.refresh_list(select_first=True)

    # ------------------------------------------------------------------ data
    def note_files(self):
        query = self.search.get_text().lower().strip()
        files = []
        for fn in os.listdir(NOTES_DIR):
            if not fn.endswith(".md"):
                continue
            path = os.path.join(NOTES_DIR, fn)
            try:
                with open(path, encoding="utf-8") as fh:
                    body = fh.read()
            except OSError:
                continue
            if query and query not in body.lower() and query not in fn.lower():
                continue
            title = next((l.lstrip("# ").strip() for l in body.splitlines()
                          if l.strip()), fn[:-3]) or fn[:-3]
            files.append((os.path.getmtime(path), path, title[:60],
                          " ".join(body.split())[:80]))
        return [f for _m, *f in sorted(files, reverse=True)]

    def refresh_list(self, select_first=False, keep=None):
        self.loading = True
        for child in self.listbox.get_children():
            self.listbox.remove(child)
        target = None
        for path, title, preview in self.note_files():
            row = Gtk.ListBoxRow()
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            box.set_border_width(6)
            t = Gtk.Label()
            t.set_markup(f"<b>{GLib.markup_escape_text(title)}</b>")
            t.set_xalign(0)
            t.set_ellipsize(Pango.EllipsizeMode.END)
            p = Gtk.Label(label=preview)
            p.set_xalign(0)
            p.set_ellipsize(Pango.EllipsizeMode.END)
            p.get_style_context().add_class("dim-label")
            box.pack_start(t, False, False, 0)
            box.pack_start(p, False, False, 0)
            row.add(box)
            row.path = path
            self.listbox.add(row)
            if keep and path == keep:
                target = row
        self.listbox.show_all()
        self.loading = False
        if target:
            self.listbox.select_row(target)
            self.load_note(target.path)
        elif select_first:
            first = self.listbox.get_row_at_index(0)
            if first:
                self.listbox.select_row(first)
                self.load_note(first.path)

    # ------------------------------------------------------------------ actions
    def on_select(self, _lb, row):
        if row is not None and not self.loading:
            self.flush_save()
            self.load_note(row.path)

    def load_note(self, path):
        try:
            with open(path, encoding="utf-8") as fh:
                text = fh.read()
        except OSError:
            text = ""
        self.loading = True
        self.current = path
        self.buffer.set_text(text)
        self.loading = False
        self.title_lbl.set_text(os.path.relpath(path, os.path.expanduser("~")))
        self.update_status()

    def new_note(self, *_):
        self.flush_save()
        stamp = time.strftime("%Y-%m-%d-%H%M%S")
        path = os.path.join(NOTES_DIR, f"note-{stamp}.md")
        with open(path, "w", encoding="utf-8") as fh:
            fh.write("# Untitled note\n\n")
        self.refresh_list(keep=path)

    def delete_note(self, *_):
        if not self.current:
            return
        dlg = Gtk.MessageDialog(transient_for=self, modal=True,
                                message_type=Gtk.MessageType.QUESTION,
                                buttons=Gtk.ButtonsType.OK_CANCEL,
                                text="Delete this note?")
        dlg.format_secondary_text(
            f"“{os.path.basename(self.current)}” will be moved to the Trash.")
        if dlg.run() == Gtk.ResponseType.OK:
            trash = os.path.expanduser("~/.local/share/Trash/files")
            os.makedirs(trash, exist_ok=True)
            dest = os.path.join(trash, os.path.basename(self.current))
            try:
                os.replace(self.current, dest)
            except OSError:
                os.remove(self.current)
            self.current = None
            self.refresh_list(select_first=True)
        dlg.destroy()

    # ------------------------------------------------------------------ saving
    def on_edited(self, *_):
        if self.loading or not self.current:
            return
        self.update_status(unsaved=True)
        if self.save_timer:
            GLib.source_remove(self.save_timer)
        self.save_timer = GLib.timeout_add(600, self.flush_save)

    def flush_save(self):
        if self.save_timer:
            GLib.source_remove(self.save_timer)
            self.save_timer = None
        if not self.current:
            return False
        start, end = self.buffer.get_bounds()
        text = self.buffer.get_text(start, end, True)
        try:
            with open(self.current, "w", encoding="utf-8") as fh:
                fh.write(text)
        except OSError as exc:
            self.status.set_text(f"Save failed: {exc}")
            return False
        self.update_status()
        if self.btn_preview.get_active():
            self.preview.set_markup(md_to_pango(text))
        return False

    def update_status(self, unsaved=False):
        start, end = self.buffer.get_bounds()
        words = len(self.buffer.get_text(start, end, True).split())
        state = "Saving…" if unsaved else "All changes saved"
        self.status.set_text(f"{state} · {words} words · Markdown")

    def toggle_preview(self, btn):
        if btn.get_active():
            self.flush_save()
            start, end = self.buffer.get_bounds()
            self.preview.set_markup(
                md_to_pango(self.buffer.get_text(start, end, True)))
            self.stack.set_visible_child_name("preview")
            btn.set_label("Edit")
        else:
            self.stack.set_visible_child_name("edit")
            btn.set_label("Preview")


def main():
    win = Notes()
    win.connect("delete-event", lambda *_: (win.flush_save(), False)[1])
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    sys.exit(main())
