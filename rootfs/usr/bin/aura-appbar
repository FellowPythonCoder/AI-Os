#!/usr/bin/env python3
"""
Aura Cool App Bar (aura-appbar)
Floating dark-blue glassmorphism quick-launch App Bar + interactive
"Search anything..." desktop search bar inspired by the Aura OS Blue Mountain
interface design.
"""
import argparse
import json
import os
import shutil
import subprocess
import sys

CONFIG_PATH = os.path.expanduser("~/.config/aura/appbar.json")

DEFAULT_ITEMS = [
    {
        "id": "launcher",
        "name": "Aura Application Launcher",
        "icon": "aura-launcher",
        "cmd": "aura-launcher",
        "badge": "APPS",
    },
    {
        "id": "terminal",
        "name": "Celestia Terminal (Zsh)",
        "icon": "celestia-shell",
        "cmd": "xfce4-terminal",
        "badge": "ZSH",
    },
    {
        "id": "files",
        "name": "AURA Finder (Files)",
        "icon": "aura-files",
        "cmd": "thunar",
        "badge": "",
    },
    {
        "id": "browser",
        "name": "AURA Web Browser",
        "icon": "aura-browser",
        "cmd": "firefox-esr",
        "badge": "",
    },
    {
        "id": "security",
        "name": "Aura Security Center (Kali Suite)",
        "icon": "aura-security",
        "cmd": "aura-security",
        "badge": "KALI",
    },
    {
        "id": "nmap",
        "name": "Nmap Network Scanner",
        "icon": "aura-nmap",
        "cmd": "aura-security --launch nmap",
        "badge": "",
    },
    {
        "id": "wireshark",
        "name": "Wireshark Packet Analyzer",
        "icon": "aura-wireshark",
        "cmd": "aura-security --launch wireshark",
