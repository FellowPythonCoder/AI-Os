#!/usr/bin/env python3
"""
Aura Security Center (aura-security)
Complete Kali Linux & Debian Security Toolkit Manager and Launcher for AURA OS.

Supports both GTK3 graphical interface and CLI actions (--list, --status,
--install, --remove, --update, --launch, --enable-kali-repo, --wireless-check).
"""
import argparse
import glob
import json
import os
import platform
import shutil
import subprocess
import sys
import threading

CATALOG_PATHS = [
    "/usr/share/aura/kali-tools.json",
    os.path.abspath(
        os.path.join(os.path.dirname(__file__), "..", "share", "aura", "kali-tools.json")
    ),
]
FAV_PATH = os.path.expanduser("~/.config/aura/security-favorites.json")
KALI_LIST_PATH = "/etc/apt/sources.list.d/kali-rolling.list"
KALI_PREF_PATH = "/etc/apt/preferences.d/kali-pinning"


def load_catalog():
    for path in CATALOG_PATHS:
        if os.path.isfile(path):
            with open(path, "r", encoding="utf-8") as f:
                return json.load(f)
    return {"version": "1.0", "categories": []}


def load_favorites():
    try:
        if os.path.isfile(FAV_PATH):
            with open(FAV_PATH, "r", encoding="utf-8") as f:
                data = json.load(f)
                if isinstance(data, list):
                    return set(data)
    except Exception:
        pass
    return {"nmap", "wireshark", "sqlmap", "john", "hydra", "aircrack-ng", "gobuster"}


def save_favorites(favs):
    try:
        os.makedirs(os.path.dirname(FAV_PATH), exist_ok=True)
        with open(FAV_PATH, "w", encoding="utf-8") as f:
            json.dump(sorted(list(favs)), f, indent=2)
    except Exception:
        pass


def is_kali_repo_enabled():
    return os.path.isfile(KALI_LIST_PATH)


def detect_wireless_hardware():
    """Check whether raw 802.11 wireless interfaces exist in this environment."""
    wireless_Paths = glob.glob("/sys/class/net/*/wireless") + glob.glob("/sys/class/ieee80211/*")
    ifaces = []
    for p in glob.glob("/sys/class/net/*/wireless"):
        parts = p.split("/")
        if len(parts) >= 5:
            ifaces.append(parts[4])
    is_vm = False
    try:
        r = subprocess.run(
            ["systemd-detect-virt"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=2,
        )
        if r.returncode == 0 and r.stdout.strip() not in ("", "none"):
            is_vm = True
    except Exception:
        if os.path.isfile("/sys/class/dmi/id/product_name"):
            try:
                prod = open("/sys/class/dmi/id/product_name").read().lower()
                if any(k in prod for k in ("qemu", "virtual", "utm", "vmware", "kvm")):
                    is_vm = True
            except Exception:
                pass
    return {
        "has_wireless": len(ifaces) > 0,
        "interfaces": sorted(set(ifaces)),
        "is_vm": is_vm,
        "summary": (
            f"802.11 wireless adapter(s) detected: {', '.join(ifaces)}"
            if ifaces
            else (
                "No raw 802.11 wireless interface detected (UTM/QEMU virtual ethernet active). "
                "Offline .cap/.pcapng auditing works natively; live monitor mode & packet injection "
                "require passing through an external USB Wi-Fi adapter in UTM USB settings."
            )
        ),
    }


def is_tool_installed(tool):
    """Honestly detect if a tool is installed via PATH binary or dpkg status."""
    bin_name = tool.get("bin", "")
    if bin_name and shutil.which(bin_name):
        return True
    for extra_dir in ("/usr/sbin", "/sbin", "/usr/local/sbin"):
        if bin_name and os.path.isfile(os.path.join(extra_dir, bin_name)):
            return True
    apt_pkg = tool.get("apt", "")
    if apt_pkg and shutil.which("dpkg-query"):
        try:
            r = subprocess.run(
                ["dpkg-query", "-W", "-f=${Status}", apt_pkg],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=3,
            )
            if "install ok installed" in r.stdout:
                return True
        except Exception:
            pass
    return False


def find_tool(catalog, tool_id_or_bin):
    needle = tool_id_or_bin.strip().lower()
    for cat in catalog.get("categories", []):
        for t in cat.get("tools", []):
            if (
                t.get("id", "").lower() == needle
                or t.get("bin", "").lower() == needle
                or t.get("apt", "").lower() == needle
            ):
                return t, cat
    return None, None


def build_enable_kali_repo_script():
    return (
        "set -e\n"
        "export DEBIAN_FRONTEND=noninteractive\n"
        "echo '[AURA Security] Configuring official Kali Rolling repository with safe Pin-Priority 100...'\n"
        "mkdir -p /etc/apt/keyrings /etc/apt/sources.list.d /etc/apt/preferences.d\n"
        "if [ ! -s /etc/apt/keyrings/kali-archive-keyring.gpg ]; then\n"
        "  curl -fsSL https://archive.kali.org/archive-key.asc | gpg --dearmor -o /etc/apt/keyrings/kali-archive-keyring.gpg\n"
        "  chmod 644 /etc/apt/keyrings/kali-archive-keyring.gpg\n"
        "fi\n"
        f"cat > {KALI_LIST_PATH} <<'EOF'\n"
        "deb [signed-by=/etc/apt/keyrings/kali-archive-keyring.gpg] http://http.kali.org/kali kali-rolling main contrib non-free non-free-firmware\n"
        "EOF\n"
        f"cat > {KALI_PREF_PATH} <<'EOF'\n"
        "Package: *\n"
        "Pin: release n=kali-rolling\n"
        "Pin-Priority: 100\n"
        "EOF\n"
        "apt-get update\n"
        "echo '[AURA Security] Kali Rolling repository enabled safely (Pin-Priority: 100).'\n"
    )


def build_apt_action_script(action, tool):
    apt_pkg = tool.get("apt", tool.get("id", ""))
    needs_kali = bool(tool.get("kali_repo")) and not is_kali_repo_enabled()
    script = "set -e\nexport DEBIAN_FRONTEND=noninteractive\n"
    if action in ("install", "update"):
        if needs_kali:
            script += build_enable_kali_repo_script()
        else:
            script += "apt-get update -y || true\n"
        if bool(tool.get("kali_repo")):
            script += f"apt-get install -y -t kali-rolling {apt_pkg} || apt-get install -y {apt_pkg}\n"
        else:
            script += f"apt-get install -y {apt_pkg}\n"
        script += f"echo '[AURA Security] {tool.get('name')} ({apt_pkg}) is ready.'\n"
    elif action == "remove":
        script += f"apt-get remove -y {apt_pkg}\n"
        script += f"echo '[AURA Security] Removed {tool.get('name')} ({apt_pkg}).'\n"
    return script


def privilege_cmd(shell_script):
    if os.geteuid() == 0:
        return ["bash", "-c", shell_script]
    if shutil.which("pkexec") and (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        return ["pkexec", "bash", "-c", shell_script]
    return ["sudo", "bash", "-c", shell_script]


def launch_tool_process(tool):
    """Launch a tool either directly (if GUI) or inside Celestia Terminal with helpful context."""
    if not is_tool_installed(tool):
        return False, f"{tool.get('name')} is not installed yet. Install package '{tool.get('apt')}' first."

    bin_name = tool.get("bin", "")
    example = tool.get("example") or f"{bin_name} --help"
    hw_note = ""
    if tool.get("wireless_hw"):
        hw = detect_wireless_hardware()
        if not hw["has_wireless"]:
            hw_note = (
                "echo -e '\\033[1;36m[AURA Wireless Notice]\\033[0m "
                + hw["summary"].replace("'", "")
                + "'\n"
            )

    if tool.get("gui") and (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        try:
            subprocess.Popen([bin_name], start_new_session=True)
            return True, f"Launched {tool.get('name')} ({bin_name})."
        except Exception as exc:
            return False, f"Failed to launch {bin_name}: {exc}"

    banner = (
        f"clear; "
        f"echo -e '\\033[1;34m╭──────────────────────────────────────────────────────────────╮\\033[0m'; "
        f"echo -e '\\033[1;34m│\\033[0m  \\033[1;36mAURA SECURITY CENTER\\033[0m · \\033[1;37m{tool.get('name')}\\033[0m'; "
        f"echo -e '\\033[1;34m│\\033[0m  Binary: \\033[1;32m{bin_name}\\033[0m   Example: \\033[0;36m{example}\\033[0m'; "
        f"echo -e '\\033[1;34m╰──────────────────────────────────────────────────────────────╯\\033[0m'; "
        f"{hw_note}"
        f"echo ''; "
        f"{example} 2>&1 | head -n 45 || true; "
        f"echo ''; "
        f"echo -e '\\033[0;36mInteractive Celestia Security Shell ready. Type `{bin_name}` commands below:\\033[0m'; "
        f"exec ${{SHELL:-/bin/zsh}}"
    )

    for term in (
        ["xfce4-terminal", "--title", f"AURA Security — {tool.get('name')}", "-x", "bash", "-c", banner],
        ["x-terminal-emulator", "-e", "bash", "-c", banner],
    ):
        if shutil.which(term[0]) and (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
            subprocess.Popen(term, start_new_session=True)
            return True, f"Opened {tool.get('name')} in Celestia Terminal."

    # Fallback when called from CLI without X11
    subprocess.run(["bash", "-c", f"{example} 2>&1 | head -n 40"], check=False)
    return True, f"Executed {example}"


# ---------------------------------------------------------------------------
# CLI Mode
# ---------------------------------------------------------------------------
def run_cli(args):
    catalog = load_catalog()
    arch = platform.machine()
    hw = detect_wireless_hardware()

    if args.wireless_check:
        print(json.dumps(hw, indent=2))
        return 0

    if args.list or args.status:
        total = 0
        installed_count = 0
        print(f"AURA Security Center — Architecture: {arch} | Kali Rolling Repo: {'enabled' if is_kali_repo_enabled() else 'optional (not enabled)'}")
        print(f"Wireless Status: {hw['summary']}\n")
        for cat in catalog.get("categories", []):
            print(f"=== {cat['name']} ===")
            for t in cat.get("tools", []):
                total += 1
                inst = is_tool_installed(t)
                if inst:
                    installed_count += 1
                badge = "[INSTALLED]" if inst else ("[KALI-REPO]" if t.get("kali_repo") else "[AVAILABLE]")
                print(f"  {badge:12} {t['id']:14} ({t['name']}) — {t['desc']}")
            print()
        print(f"Summary: {installed_count}/{total} security tools currently installed.")
        return 0

    if args.enable_kali_repo:
        cmd = privilege_cmd(build_enable_kali_repo_script())
        return subprocess.call(cmd)

    target_id = args.install or args.remove or args.update or args.launch
    if target_id:
        tool, _cat = find_tool(catalog, target_id)
        if not tool:
            print(f"Error: Tool '{target_id}' not found in Aura Security Center catalog.", file=sys.stderr)
            return 1
        if args.launch:
            ok, msg = launch_tool_process(tool)
            print(msg)
            return 0 if ok else 1
        action = "install" if args.install else ("remove" if args.remove else "update")
        script = build_apt_action_script(action, tool)
        return subprocess.call(privilege_cmd(script))

    return None


# ---------------------------------------------------------------------------
# GTK3 GUI Mode
# ---------------------------------------------------------------------------
