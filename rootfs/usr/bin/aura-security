def run_gui():
    import gi

    gi.require_version("Gtk", "3.0")
    from gi.repository import GLib, Gtk, Pango

    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gtk.Window().get_screen(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    class SecurityCenterWindow(Gtk.Window):
        def __init__(self):
            super().__init__(title="Aura Security Center — Kali & Defensive Toolkit")
            self.set_default_size(1140, 740)
            self.set_position(Gtk.WindowPosition.CENTER)
            self.set_icon_name("aura-security")

            self.catalog = load_catalog()
            self.favorites = load_favorites()
            self.active_category = "all"
            self.search_query = ""
            self.busy = False

            root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            self.add(root)

            # Top header bar
            header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
            header.get_style_context().add_class("sec-header")

            icon_img = Gtk.Image.new_from_icon_name("aura-security", Gtk.IconSize.DIALOG)
            header.pack_start(icon_img, False, False, 0)

            title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            t_lbl = Gtk.Label(label="AURA SECURITY CENTER", xalign=0)
            t_lbl.get_style_context().add_class("sec-title")
            s_lbl = Gtk.Label(
                label=f"Kali Linux & Debian Security Suite · Arch: {platform.machine()} · Authorized & Educational Use",
                xalign=0,
            )
            s_lbl.get_style_context().add_class("sec-subtitle")
            title_box.pack_start(t_lbl, False, False, 0)
            title_box.pack_start(s_lbl, False, False, 0)
            header.pack_start(title_box, False, False, 0)

            # Search entry
            self.search_entry = Gtk.SearchEntry()
            self.search_entry.set_placeholder_text("Search Nmap, Wireshark, Metasploit, SQLMap, Hydra...")
            self.search_entry.set_size_request(300, -1)
            self.search_entry.connect("search-changed", self.on_search_changed)
            header.pack_end(self.search_entry, False, False, 0)

            # Kali repo toggle button
            self.kali_btn = Gtk.Button()
            self.kali_btn.get_style_context().add_class("btn-secondary")
            self.kali_btn.connect("clicked", self.on_enable_kali_repo)
            header.pack_end(self.kali_btn, False, False, 0)
            self.update_kali_repo_button()

            root.pack_start(header, False, False, 0)

            # Main split pane
            body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
            root.pack_start(body, True, True, 0)

            # Left category sidebar
            sidebar_scroll = Gtk.ScrolledWindow()
            sidebar_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            sidebar_scroll.set_size_request(250, -1)
            self.sidebar = Gtk.ListBox()
            self.sidebar.set_selection_mode(Gtk.SelectionMode.SINGLE)
            self.sidebar.get_style_context().add_class("sec-sidebar")
            self.sidebar.connect("row-selected", self.on_category_selected)
            sidebar_scroll.add(self.sidebar)
            body.pack_start(sidebar_scroll, False, False, 0)

            self.populate_sidebar()

            # Right content area
            right_col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            right_col.set_margin_top(14)
            right_col.set_margin_bottom(14)
            right_col.set_margin_start(18)
            right_col.set_margin_end(18)
            body.pack_start(right_col, True, True, 0)

            # Wireless / VM hardware status banner
            hw = detect_wireless_hardware()
            hw_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            hw_box.get_style_context().add_class("hw-banner")
            hw_lbl = Gtk.Label(label=f"◈ Hardware & VM Environment: {hw['summary']}", xalign=0)
            hw_lbl.set_line_wrap(True)
            hw_box.pack_start(hw_lbl, True, True, 0)
            self.stats_lbl = Gtk.Label(label="", xalign=1)
            hw_box.pack_end(self.stats_lbl, False, False, 0)
            right_col.pack_start(hw_box, False, False, 0)

            # Scrollable tool list
            self.tools_scroll = Gtk.ScrolledWindow()
            self.tools_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            self.tools_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            self.tools_scroll.add(self.tools_box)
            right_col.pack_start(self.tools_scroll, True, True, 0)

            # Live progress & command output drawer
            log_frame = Gtk.Frame(label=" Package & Tool Activity Log ")
            log_scroll = Gtk.ScrolledWindow()
            log_scroll.set_size_request(-1, 110)
            self.log_view = Gtk.TextView()
            self.log_view.set_editable(False)
            self.log_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
            self.log_view.get_style_context().add_class("log-box")
            log_scroll.add(self.log_view)
            log_frame.add(log_scroll)
            right_col.pack_start(log_frame, False, False, 0)

            self.append_log(
                "Aura Security Center ready. Installed status is verified live against PATH and dpkg."
            )
            self.refresh_tools()

        def update_kali_repo_button(self):
            if is_kali_repo_enabled():
                self.kali_btn.set_label("✓ Kali Rolling Repo (Pinned 100)")
            else:
                self.kali_btn.set_label("+ Enable Kali Rolling Repo")

        def populate_sidebar(self):
            special = [
                ("all", "All Security Tools", "aura-security"),
                ("favorites", "★ Favorites", "aura-security"),
                ("installed", "● Installed Tools", "aura-security"),
            ]
            for cid, name, icon in special:
                self.sidebar.add(self.make_sidebar_row(cid, name, icon))
            for cat in self.catalog.get("categories", []):
                self.sidebar.add(
                    self.make_sidebar_row(cat["id"], cat["name"], cat.get("icon", "aura-security"))
                )
            self.sidebar.show_all()
            self.sidebar.select_row(self.sidebar.get_row_at_index(0))

        def make_sidebar_row(self, cid, title, icon_name):
            row = Gtk.ListBoxRow()
            row.category_id = cid
            hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            hbox.set_margin_top(7)
            hbox.set_margin_bottom(7)
            hbox.set_margin_start(8)
            hbox.set_margin_end(8)
            img = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.MENU)
            lbl = Gtk.Label(label=title, xalign=0)
            hbox.pack_start(img, False, False, 0)
            hbox.pack_start(lbl, True, True, 0)
            row.add(hbox)
            return row

        def append_log(self, line):
            buf = self.log_view.get_buffer()
            end_iter = buf.get_end_iter()
            buf.insert(end_iter, line.rstrip() + "\n")
            mark = buf.create_mark(None, buf.get_end_iter(), False)
            self.log_view.scroll_to_mark(mark, 0.0, True, 0.0, 1.0)

        def on_search_changed(self, entry):
            self.search_query = entry.get_text().strip().lower()
            self.refresh_tools()

        def on_category_selected(self, _listbox, row):
            if row is not None:
                self.active_category = getattr(row, "category_id", "all")
                self.refresh_tools()

        def refresh_tools(self):
            for child in self.tools_box.get_children():
                self.tools_box.remove(child)

            total_all = 0
            installed_all = 0
            seen_ids = set()

            for cat in self.catalog.get("categories", []):
                for tool in cat.get("tools", []):
                    tid = tool["id"]
                    if tid in seen_ids:
                        continue
                    seen_ids.add(tid)
                    inst = is_tool_installed(tool)
                    total_all += 1
                    if inst:
                        installed_all += 1

                    if self.active_category == "favorites" and tid not in self.favorites:
                        continue
                    if self.active_category == "installed" and not inst:
                        continue
                    if (
                        self.active_category not in ("all", "favorites", "installed")
                        and cat["id"] != self.active_category
                    ):
                        continue

                    haystack = f"{tool['name']} {tool['id']} {tool.get('bin','')} {tool.get('desc','')} {cat['name']}".lower()
                    if self.search_query and self.search_query not in haystack:
                        continue

                    self.tools_box.pack_start(self.build_tool_card(tool, cat, inst), False, False, 0)

            self.stats_lbl.set_text(f"{installed_all} / {total_all} Installed")
            self.tools_box.show_all()

        def build_tool_card(self, tool, cat, installed):
            card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
            card.get_style_context().add_class("sec-card")

            icon = Gtk.Image.new_from_icon_name(tool.get("icon", "aura-security"), Gtk.IconSize.DND)
            card.pack_start(icon, False, False, 0)

            info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            top_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)

            name_lbl = Gtk.Label(xalign=0)
            name_lbl.set_markup(f"<b>{GLib.markup_escape_text(tool['name'])}</b>")
            top_row.pack_start(name_lbl, False, False, 0)

            badge = Gtk.Label(
                label="● Installed"
                if installed
                else ("◇ Kali Rolling Repo" if tool.get("kali_repo") else "○ Available (APT)")
            )
            badge.get_style_context().add_class(
                "badge-installed"
                if installed
                else ("badge-kali" if tool.get("kali_repo") else "badge-available")
            )
            top_row.pack_start(badge, False, False, 0)

            cat_lbl = Gtk.Label(label=f"·  {cat['name']}  ·  pkg: {tool.get('apt')}", xalign=0)
            cat_lbl.get_style_context().add_class("sec-subtitle")
            top_row.pack_start(cat_lbl, False, False, 0)

            info.pack_start(top_row, False, False, 0)

            desc_lbl = Gtk.Label(label=tool.get("desc", ""), xalign=0)
            desc_lbl.set_line_wrap(True)
            desc_lbl.set_max_width_chars(78)
            desc_lbl.set_ellipsize(Pango.EllipsizeMode.NONE)
            info.pack_start(desc_lbl, False, False, 0)

            card.pack_start(info, True, True, 0)

            # Action buttons
            actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            actions.set_valign(Gtk.Align.CENTER)

            fav_btn = Gtk.Button(label="★" if tool["id"] in self.favorites else "☆")
            fav_btn.get_style_context().add_class("btn-secondary")
            fav_btn.set_tooltip_text("Toggle favorite")
            fav_btn.connect("clicked", self.on_toggle_favorite, tool["id"])
            actions.pack_start(fav_btn, False, False, 0)

            if installed:
                launch_btn = Gtk.Button(label="Launch")
                launch_btn.get_style_context().add_class("btn-launch")
                launch_btn.connect("clicked", self.on_launch_tool, tool)
                actions.pack_start(launch_btn, False, False, 0)

                upd_btn = Gtk.Button(label="Update")
                upd_btn.get_style_context().add_class("btn-secondary")
                upd_btn.connect("clicked", self.on_pkg_action, "update", tool)
                actions.pack_start(upd_btn, False, False, 0)

                rm_btn = Gtk.Button(label="Remove")
                rm_btn.get_style_context().add_class("btn-danger")
                rm_btn.connect("clicked", self.on_pkg_action, "remove", tool)
                actions.pack_start(rm_btn, False, False, 0)
            else:
                inst_btn = Gtk.Button(label="Install")
                inst_btn.get_style_context().add_class("btn-launch")
                inst_btn.connect("clicked", self.on_pkg_action, "install", tool)
                actions.pack_start(inst_btn, False, False, 0)

            card.pack_end(actions, False, False, 0)
            return card

        def on_toggle_favorite(self, _btn, tool_id):
            if tool_id in self.favorites:
                self.favorites.remove(tool_id)
            else:
                self.favorites.add(tool_id)
            save_favorites(self.favorites)
            self.refresh_tools()

        def on_launch_tool(self, _btn, tool):
            ok, msg = launch_tool_process(tool)
            self.append_log(msg)

        def on_enable_kali_repo(self, _btn):
            if self.busy:
                return
            self.run_privileged_async(
                "Enabling official Kali Rolling repository (Pin-Priority: 100)...",
                build_enable_kali_repo_script(),
            )

        def on_pkg_action(self, _btn, action, tool):
            if self.busy:
                self.append_log("Another package operation is currently running; please wait.")
                return
            script = build_apt_action_script(action, tool)
            self.run_privileged_async(
                f"Running {action} for {tool['name']} ({tool.get('apt')})...", script
            )

        def run_privileged_async(self, banner_msg, script):
            self.busy = True
            self.append_log(f"==> {banner_msg}")

            def worker():
                cmd = privilege_cmd(script)
                try:
                    proc = subprocess.Popen(
                        cmd,
                        stdout=subprocess.PIPE,
                        stderr=subprocess.STDOUT,
                        text=True,
                    )
                    for line in proc.stdout:
                        GLib.idle_add(self.append_log, line.rstrip())
                    rc = proc.wait()
                    if rc == 0:
                        GLib.idle_add(self.append_log, "==> Operation completed successfully.")
                    else:
                        GLib.idle_add(
                            self.append_log, f"==> Operation exited with status code {rc}."
                        )
                except Exception as exc:
                    GLib.idle_add(self.append_log, f"==> Error: {exc}")
                finally:
                    GLib.idle_add(self.finish_async_op)

            threading.Thread(target=worker, daemon=True).start()

        def finish_async_op(self):
            self.busy = False
            self.update_kali_repo_button()
            self.refresh_tools()

    win = SecurityCenterWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
    return 0


def main():
    parser = argparse.ArgumentParser(
        description="Aura Security Center — Kali Linux & Debian Security Suite"
    )
    parser.add_argument("--list", action="store_true", help="List all catalog security tools and status")
    parser.add_argument("--status", action="store_true", help="Show installed vs available security tools")
    parser.add_argument("--install", metavar="TOOL", help="Install a security tool by id or binary name")
    parser.add_argument("--remove", metavar="TOOL", help="Remove a security tool by id or binary name")
    parser.add_argument("--update", metavar="TOOL", help="Update a security tool by id or binary name")
    parser.add_argument("--launch", metavar="TOOL", help="Launch a security tool")
    parser.add_argument(
        "--enable-kali-repo",
        action="store_true",
        help="Configure official kali-rolling repository with safe Pin-Priority 100",
    )
    parser.add_argument(
        "--wireless-check",
        action="store_true",
        help="Check 802.11 wireless hardware and VM passthrough status",
    )
    args = parser.parse_args()

    cli_rc = run_cli(args)
    if cli_rc is not None:
        sys.exit(cli_rc)

    if not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        args.status = True
        sys.exit(run_cli(args) or 0)

    sys.exit(run_gui())


if __name__ == "__main__":
    main()
