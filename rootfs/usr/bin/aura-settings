#!/usr/bin/env python3
"""
AURA Settings — the visual control center for AURA OS.

Every control applies immediately through the `aura` CLI or xfconf,
so GUI and Celestia Shell always agree. Preferences persist in
~/.config/aura/config.json.
"""
import json
import os
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GdkPixbuf, GLib  # noqa: E402

CONFIG_FILE = os.path.expanduser("~/.config/aura/config.json")
WP_DIR = "/usr/share/backgrounds/aura"
if not os.path.isdir(WP_DIR):
    WP_DIR = os.path.normpath(os.path.join(
        os.path.dirname(os.path.abspath(__file__)), "..", "share",
        "backgrounds", "aura"))
TERMINALRC = os.path.expanduser("~/.config/xfce4/terminal/terminalrc")

ACCENTS = [
    ("ocean", "Ocean", "#2f7fe0"), ("electric", "Electric", "#1e90ff"),
    ("glacier", "Glacier", "#38b6e8"), ("midnight", "Midnight", "#3b5bdb"),
    ("cyan", "Cyan", "#18b7c4"), ("teal", "Teal", "#14b8a6"),
    ("violet", "Violet", "#7c5cd6"),
]


def load_config():
    cfg = {"theme_mode": "dark", "accent": "ocean",
           "wallpaper": "aura-midnight-peaks.jpg",
           "dock": {"size": 52, "position": "bottom", "zoom": True,
                    "autohide": False}}
    try:
        with open(CONFIG_FILE, encoding="utf-8") as fh:
            saved = json.load(fh)
        cfg.update({k: v for k, v in saved.items() if k != "dock"})
        if isinstance(saved.get("dock"), dict):
            cfg["dock"].update(saved["dock"])
    except (OSError, json.JSONDecodeError):
        pass
    return cfg


def aura_cmd(*args):
    subprocess.Popen(["aura", *args], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL)


def xfconf(channel, prop, ptype, value):
    subprocess.Popen(["xfconf-query", "-c", channel, "-p", prop, "-t", ptype,
                      "-s", str(value), "--create"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def markup_title(text):
    lbl = Gtk.Label()
    lbl.set_markup(f'<span size="x-large" weight="bold">{text}</span>')
    lbl.set_xalign(0)
    return lbl


def section(text):
    lbl = Gtk.Label()
    lbl.set_markup(f"<b>{text}</b>")
    lbl.set_xalign(0)
    lbl.set_margin_top(10)
    return lbl


class Settings(Gtk.Window):
    def __init__(self, start_page=None):
        super().__init__(title="AURA Settings")
        self.set_default_size(980, 640)
        try:
            self.set_icon_name("aura-settings")
        except Exception:
            pass
        self.cfg = load_config()

        header = Gtk.HeaderBar(title="AURA Settings",
                               subtitle="Make this mountain yours")
        header.set_show_close_button(True)
        self.set_titlebar(header)
        self.status = Gtk.Label()
        header.pack_end(self.status)

        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        paned.set_position(215)
        self.add(paned)

        self.sidebar = Gtk.ListBox()
        self.sidebar.connect("row-selected", self.on_page)
        sb = Gtk.ScrolledWindow()
        sb.add(self.sidebar)
        sb.get_style_context().add_class("sidebar")
        paned.add1(sb)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_UP_DOWN)
        sw = Gtk.ScrolledWindow()
        sw.add(self.stack)
        paned.add2(sw)

        pages = [
            ("appearance", "🎨  Appearance", self.page_appearance),
            ("wallpaper", "🏔  Wallpaper", self.page_wallpaper),
            ("dock", "🧊  Dock & Menu Bar", self.page_dock),
            ("effects", "✨  Effects", self.page_effects),
            ("terminal", "⌨️  Celestia Shell", self.page_terminal),
            ("system", "⚙️  System", self.page_system),
            ("about", "ℹ️  About", self.page_about),
        ]
        self.page_rows = {}
        for pid, title, builder in pages:
            row = Gtk.ListBoxRow()
            lbl = Gtk.Label(label=title)
            lbl.set_xalign(0)
            lbl.set_margin_start(10)
            lbl.set_margin_top(6)
            lbl.set_margin_bottom(6)
            row.add(lbl)
            row.pid = pid
            self.sidebar.add(row)
            self.page_rows[pid] = row
            self.stack.add_named(builder(), pid)
        self.sidebar.show_all()
        target = self.page_rows.get(start_page or "appearance")
        if target:
            self.sidebar.select_row(target)

    # ------------------------------------------------------------------ util
    def toast(self, text):
        self.status.set_text(text)
        GLib.timeout_add(2600, lambda: (self.status.set_text(""), False)[1])

    def on_page(self, _lb, row):
        if row is not None:
            self.stack.set_visible_child_name(row.pid)

    def page_box(self, title):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_border_width(22)
        box.pack_start(markup_title(title), False, False, 0)
        return box

    # ------------------------------------------------------------------ pages
    def page_appearance(self):
        box = self.page_box("Appearance")
        box.pack_start(section("Mode"), False, False, 0)
        modes = Gtk.Box(spacing=8)
        self.radio_dark = Gtk.RadioButton(label="🌙  Dark — Midnight Peaks")
        self.radio_light = Gtk.RadioButton(
            group=self.radio_dark, label="☀️  Light — Glacier Dawn")
        for r, mode in ((self.radio_dark, "dark"), (self.radio_light, "light")):
            r.set_active(self.cfg["theme_mode"] == mode)
            r.connect("toggled", self._mode_toggled, mode)
            modes.pack_start(r, False, False, 0)
        box.pack_start(modes, False, False, 0)

        box.pack_start(section("Accent color"), False, False, 0)
        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_max_children_per_line(7)
        flow.set_homogeneous(True)
        for name, label, hexv in ACCENTS:
            btn = Gtk.Button()
            btn.set_size_request(58, 58)
            btn.set_tooltip_text(f"{label}  {hexv}")
            css = Gtk.CssProvider()
            border = "3px solid white" if self.cfg["accent"] == name else "1px solid rgba(255,255,255,0.35)"
            css.load_from_data(
                f"button {{ background: {hexv}; background-image: none; "
                f"border-radius: 16px; border: {border}; }}".encode())
            btn.get_style_context().add_provider(
                css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            btn.connect("clicked", self._accent_clicked, name, label)
            wrap = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            wrap.pack_start(btn, False, False, 0)
            cap = Gtk.Label(label=label)
            cap.get_style_context().add_class("dim-label")
            wrap.pack_start(cap, False, False, 0)
            flow.add(wrap)
        box.pack_start(flow, False, False, 0)

        custom = Gtk.Box(spacing=8)
        custom.pack_start(Gtk.Label(label="Custom color:"), False, False, 0)
        self.color_btn = Gtk.ColorButton()
        rgba = Gdk.RGBA()
        rgba.parse(self.cfg.get("accent_hex", "#2f7fe0"))
        self.color_btn.set_rgba(rgba)
        custom.pack_start(self.color_btn, False, False, 0)
        b_apply = Gtk.Button(label="Apply custom accent")
        b_apply.connect("clicked", self._custom_accent)
        custom.pack_start(b_apply, False, False, 0)
        box.pack_start(custom, False, False, 0)

        box.pack_start(section("Icons & cursor"), False, False, 0)
        grid = Gtk.Grid(column_spacing=10, row_spacing=8)
        grid.attach(Gtk.Label(label="Icon theme"), 0, 0, 1, 1)
        self.icon_combo = self._theme_combo("/usr/share/icons", "AuraIcons")
        self.icon_combo.connect("changed", self._icon_theme_changed)
        grid.attach(self.icon_combo, 1, 0, 1, 1)
        grid.attach(Gtk.Label(label="Cursor theme"), 0, 1, 1, 1)
        self.cursor_combo = self._theme_combo("/usr/share/icons", "AuraCursor")
        self.cursor_combo.connect("changed", self._cursor_theme_changed)
        grid.attach(self.cursor_combo, 1, 1, 1, 1)
        box.pack_start(grid, False, False, 0)

        box.pack_start(section("Text"), False, False, 0)
        frow = Gtk.Box(spacing=8)
        frow.pack_start(Gtk.Label(label="Interface font:"), False, False, 0)
        self.font_btn = Gtk.FontButton()
        self.font_btn.set_font_name("Inter 11")
        self.font_btn.connect("font-set", self._font_set)
        frow.pack_start(self.font_btn, False, False, 0)
        box.pack_start(frow, False, False, 0)
        srow = Gtk.Box(spacing=8)
        srow.pack_start(Gtk.Label(label="Text scaling:"), False, False, 0)
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL,
                                         0.8, 2.0, 0.1)
        scale.set_value(1.0)
        scale.set_size_request(220, -1)
        scale.connect("value-changed", self._scaling)
        srow.pack_start(scale, False, False, 0)
        box.pack_start(srow, False, False, 0)

        b_reset = Gtk.Button(label="Restore AURA defaults")
        b_reset.set_margin_top(16)
        b_reset.connect("clicked", lambda *_: (aura_cmd("theme", "reset"),
                                               self.toast("Defaults restored")))
        box.pack_start(b_reset, False, False, 0)
        return box

    def page_wallpaper(self):
        box = self.page_box("Wallpaper")
        note = Gtk.Label(label="Click a scene to apply it instantly. "
                               "Your own images belong in ~/Pictures.")
        note.set_xalign(0)
        note.get_style_context().add_class("dim-label")
        note.set_line_wrap(True)
        box.pack_start(note, False, False, 0)
        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_max_children_per_line(2)
        flow.set_column_spacing(10)
        flow.set_row_spacing(10)
        files = []
        if os.path.isdir(WP_DIR):
            files = sorted(f for f in os.listdir(WP_DIR)
                           if f.lower().endswith((".jpg", ".png", ".jpeg")))
        for fn in files:
            path = os.path.join(WP_DIR, fn)
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                    path, 300, 169, True)
                img = Gtk.Image.new_from_pixbuf(pix)
            except GLib.Error:
                img = Gtk.Image.new_from_icon_name("aura-photos",
                                                   Gtk.IconSize.DIALOG)
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            btn = Gtk.Button()
            btn.add(img)
            btn.connect("clicked", self._wallpaper_clicked, fn)
            col.pack_start(btn, False, False, 0)
            name = os.path.splitext(fn)[0].replace("aura-", "").replace("-", " ").title()
            mark = " ● in use" if fn == self.cfg["wallpaper"] else ""
            col.pack_start(Gtk.Label(label=name + mark), False, False, 0)
            flow.add(col)
        box.pack_start(flow, False, False, 0)
        b_choose = Gtk.Button(label="Choose a picture of your own…")
        b_choose.connect("clicked", self._choose_wallpaper)
        box.pack_start(b_choose, False, False, 0)
        return box

    def page_dock(self):
        box = self.page_box("Dock & Menu Bar")
        dock = self.cfg["dock"]
        box.pack_start(section("Dock icon size"), False, False, 0)
        size = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 32, 96, 2)
        size.set_value(dock["size"])
        size.set_size_request(300, -1)
        size.connect("change-value", lambda s, *_: self._dock_size(s))
        box.pack_start(size, False, False, 0)

        box.pack_start(section("Dock position"), False, False, 0)
        pos = Gtk.ComboBoxText()
        for p in ("bottom", "left", "right", "top"):
            pos.append_text(p)
        pos.set_active(("bottom", "left", "right", "top").index(dock["position"]))
        pos.connect("changed", lambda c: aura_cmd(
            "dock", "position", c.get_active_text()) or self.toast("Dock moved"))
        box.pack_start(pos, False, False, 0)

        for label, key in (("Magnify icons on hover", "zoom"),
                           ("Auto-hide the dock", "autohide")):
            row = Gtk.Box(spacing=8)
            sw = Gtk.Switch(active=bool(dock[key]))
            sw.connect("notify::active", self._dock_switch, key)
            row.pack_start(sw, False, False, 0)
            row.pack_start(Gtk.Label(label=label), False, False, 0)
            box.pack_start(row, False, False, 0)

        box.pack_start(section("Menu bar height"), False, False, 0)
        panel_size = Gtk.Scale.new_with_range(
            Gtk.Orientation.HORIZONTAL, 26, 48, 1)
        panel_size.set_value(34)
        panel_size.set_size_request(300, -1)
        panel_size.connect("change-value", lambda s, *_: xfconf(
            "xfce4-panel", "/panels/panel-1/size", "uint",
            str(int(s.get_value()))))
        box.pack_start(panel_size, False, False, 0)
        tip = Gtk.Label(label="Tip: right-click the dock for even more options, "
                              "and drag icons to rearrange them.")
        tip.set_xalign(0)
        tip.set_line_wrap(True)
        tip.get_style_context().add_class("dim-label")
        box.pack_start(tip, False, False, 0)
        return box

    def page_effects(self):
        box = self.page_box("Effects & Performance")
        intro = Gtk.Label(label="AURA balances beauty and speed inside the VM. "
                                "If anything feels heavy, start here.")
        intro.set_xalign(0)
        intro.set_line_wrap(True)
        intro.get_style_context().add_class("dim-label")
        box.pack_start(intro, False, False, 0)
        options = [
            ("Compositor (transparency & shadows)",
             ("xfwm4", "/general/use_compositing")), ("Window shadows",
             ("xfwm4", "/general/show_frame_shadow")), ("Popup shadows",
             ("xfwm4", "/general/show_popup_shadow")), ("Zoom desktop (Super + scroll)",
             ("xfwm4", "/general/zoom_desktop")), ("Snap windows to edges",
             ("xfwm4", "/general/snap_to_border")), ("Tile by dragging to edges",
             ("xfwm4", "/general/tile_on_move"))]
        for label, (chan, prop) in options:
            row = Gtk.Box(spacing=8)
            sw = Gtk.Switch(active=True)
            sw.connect("notify::active",
                       lambda s, _p, c=chan, p=prop: xfconf(
                           c, p, "bool", str(s.get_active()).lower()))
            row.pack_start(sw, False, False, 0)
            row.pack_start(Gtk.Label(label=label), False, False, 0)
            box.pack_start(row, False, False, 0)
        box.pack_start(section("Animations"), False, False, 0)
        row = Gtk.Box(spacing=8)
        anim = Gtk.Switch(active=True)
        anim.connect("notify::active", self._animations)
        row.pack_start(anim, False, False, 0)
        row.pack_start(Gtk.Label(label="Interface animations (GTK)"),
                       False, False, 0)
        box.pack_start(row, False, False, 0)
        note = Gtk.Label(label="Toggles apply to new windows; some take effect "
                               "at next login.")
        note.set_xalign(0)
        note.get_style_context().add_class("dim-label")
        box.pack_start(note, False, False, 0)
        return box

    def page_terminal(self):
        box = self.page_box("Celestia Shell")
        intro = Gtk.Label(label="Celestia is a real Zsh terminal. These settings "
                                "edit ~/.config/xfce4/terminal/terminalrc.")
        intro.set_xalign(0)
        intro.set_line_wrap(True)
        intro.get_style_context().add_class("dim-label")
        box.pack_start(intro, False, False, 0)

        box.pack_start(section("Terminal font"), False, False, 0)
        self.term_font = Gtk.FontButton()
        self.term_font.set_font_name(self._terminalrc_get("FontName")
                                     or "JetBrains Mono 11")
        self.term_font.connect("font-set", lambda b: self._terminalrc_set(
            "FontName", b.get_font_name()))
        box.pack_start(self.term_font, False, False, 0)

        box.pack_start(section("Background opacity"), False, False, 0)
        try:
            current_dark = float(self._terminalrc_get("BackgroundDarkness")
                                 or "0.92")
        except ValueError:
            current_dark = 0.92
        opa = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL,
                                       0.5, 1.0, 0.01)
        opa.set_value(current_dark)
        opa.set_size_request(300, -1)
        opa.connect("change-value", lambda s, *_: self._terminalrc_set(
            "BackgroundDarkness", f"{s.get_value():.3f}"))
        box.pack_start(opa, False, False, 0)

        box.pack_start(section("Color scheme"), False, False, 0)
        scheme_dir = "/usr/share/xfce4/terminal/colorschemes"
        schemes = ["Celestia"]
        if os.path.isdir(scheme_dir):
            schemes = sorted({os.path.splitext(f)[0] for f in os.listdir(scheme_dir)})
        combo = Gtk.ComboBoxText()
        for s in schemes:
            combo.append_text(s)
        current = self._terminalrc_get("ColorScheme") or "Celestia"
        if current in schemes:
            combo.set_active(schemes.index(current))
        combo.connect("changed", lambda c: self._terminalrc_set(
            "ColorScheme", c.get_active_text()))
        box.pack_start(combo, False, False, 0)

        box.pack_start(section("Login shell"), False, False, 0)
        srow = Gtk.Box(spacing=8)
        for shell in ("zsh", "bash"):
            b = Gtk.Button(label=f"Use {shell}")
            b.connect("clicked", lambda _b, s=shell: subprocess.Popen(
                ["xfce4-terminal", "--title=Change shell", "-e",
                 f"chsh -s /bin/{s}; echo; read -p 'Done — press Enter…' _"]))
            srow.pack_start(b, False, False, 0)
        box.pack_start(srow, False, False, 0)

        b_open = Gtk.Button(label="Open Celestia Shell")
        b_open.get_style_context().add_class("suggested-action")
        b_open.set_margin_top(14)
        b_open.connect("clicked", lambda *_: subprocess.Popen(
            ["xfce4-terminal", "--title=Celestia Shell"]))
        box.pack_start(b_open, False, False, 0)
        return box

    def page_system(self):
        box = self.page_box("System")
        entries = [
            ("Display", "Resolution, refresh rate, multiple monitors",
             ["xfce4-display-settings"]),
            ("Power", "Sleep, screen blanking and VM power behavior",
             ["xfce4-power-manager-settings"]),
            ("Mouse & Touchpad", "Pointer speed, scrolling direction",
             ["xfce4-mouse-settings"]),
            ("Keyboard", "Layout, repeat rate and application shortcuts",
             ["xfce4-keyboard-settings"]),
            ("Sound", "Output device and volume (PulseAudio)",
             ["pavucontrol"]),
            ("Network", "Wi-Fi / wired connections (via UTM NAT)",
             ["nm-connection-editor"]),
            ("All Xfce Settings", "Every desktop control panel",
             ["xfce4-settings-manager"]),
            ("AURA App Center", "Install software and system updates",
             ["aura-appcenter"]),
            ("AURA Backup", "Snapshots and restore points",
             ["aura", "backup"]),
        ]
        for name, desc, cmd in entries:
            row = Gtk.Box(spacing=10)
            row.set_margin_top(4)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            t = Gtk.Label()
            t.set_markup(f"<b>{name}</b>")
            t.set_xalign(0)
            d = Gtk.Label(label=desc)
            d.set_xalign(0)
            d.get_style_context().add_class("dim-label")
            text.pack_start(t, False, False, 0)
            text.pack_start(d, False, False, 0)
            row.pack_start(text, True, True, 0)
            b = Gtk.Button(label="Open")
            b.connect("clicked", lambda _b, c=cmd: subprocess.Popen(
                c, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
            row.pack_start(b, False, False, 0)
            box.pack_start(row, False, False, 0)
        return box

    def page_about(self):
        box = self.page_box("About AURA OS")
        logo = Gtk.Image.new_from_icon_name("aura-logo", Gtk.IconSize.DIALOG)
        logo.set_pixel_size(96)
        box.pack_start(logo, False, False, 0)
        lbl = Gtk.Label()
        lbl.set_markup("AURA OS 1.0 “Aurora Peaks”\n"
                       "<span size=\"small\">A blue-mountain desktop built on "
                       "Debian GNU/Linux 12.\nRunning as an ARM64 virtual "
                       "machine in UTM.</span>")
        lbl.set_xalign(0)
        box.pack_start(lbl, False, False, 0)
        b = Gtk.Button(label="Detailed system information…")
        b.connect("clicked", lambda *_: subprocess.Popen(["aura-about"]))
        box.pack_start(b, False, False, 0)
        credits = Gtk.Label(label="AURA stands on the shoulders of Debian, Xfce, "
                                  "the Linux kernel and thousands of free-software "
                                  "authors. Thank you.")
        credits.set_xalign(0)
        credits.set_line_wrap(True)
        credits.get_style_context().add_class("dim-label")
        box.pack_start(credits, False, False, 0)
        return box

    # ------------------------------------------------------------------ handlers
    def _mode_toggled(self, btn, mode):
        if btn.get_active():
            aura_cmd("theme", mode)
            self.toast(f"{mode.capitalize()} mode")

    def _accent_clicked(self, _b, name, label):
        aura_cmd("theme", "accent", name)
        self.toast(f"Accent: {label}")

    def _custom_accent(self, _b):
        rgba = self.color_btn.get_rgba()
        hexv = "#%02x%02x%02x" % (int(rgba.red * 255), int(rgba.green * 255),
                                  int(rgba.blue * 255))
        aura_cmd("theme", "accent", hexv)
        self.toast(f"Accent: {hexv}")

    def _theme_combo(self, base, preferred):
        combo = Gtk.ComboBoxText()
        names = []
        if os.path.isdir(base):
            for d in sorted(os.listdir(base)):
                if os.path.isfile(os.path.join(base, d, "index.theme")):
                    names.append(d)
        if preferred not in names:
            names.insert(0, preferred)
        for n in names:
            combo.append_text(n)
        combo.set_active(names.index(preferred))
        return combo

    def _icon_theme_changed(self, combo):
        name = combo.get_active_text()
        if name:
            xfconf("xsettings", "/Net/IconThemeName", "string", name)
            self.toast(f"Icons: {name}")

    def _cursor_theme_changed(self, combo):
        name = combo.get_active_text()
        if name:
            xfconf("xsettings", "/Gtk/CursorThemeName", "string", name)
            self.toast(f"Cursor: {name} (applies at next login)")

    def _font_set(self, btn):
        xfconf("xsettings", "/Gtk/FontName", "string", btn.get_font_name())
        self.toast("Font updated")

    def _scaling(self, scale):
        dpi = int(round(96 * scale.get_value()))
        xfconf("xsettings", "/Xft/DPI", "int", str(dpi))
        self.toast(f"Text scaling ≈ {scale.get_value():.1f}× ({dpi} DPI)")

    def _wallpaper_clicked(self, _b, filename):
        aura_cmd("wallpaper", "set", os.path.splitext(filename)[0])
        self.toast("Wallpaper updated")

    def _choose_wallpaper(self, _b):
        dlg = Gtk.FileChooserDialog(title="Choose wallpaper", transient_for=self,
                                    action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                        "Set Wallpaper", Gtk.ResponseType.OK)
        filt = Gtk.FileFilter()
        filt.set_name("Images")
        for pat in ("*.jpg", "*.jpeg", "*.png", "*.webp"):
            filt.add_pattern(pat)
        dlg.add_filter(filt)
        dlg.set_current_folder(os.path.expanduser("~/Pictures"))
        if dlg.run() == Gtk.ResponseType.OK:
            aura_cmd("wallpaper", "set", dlg.get_filename())
            self.toast("Wallpaper updated")
        dlg.destroy()

    def _dock_size(self, scale):
        aura_cmd("dock", "size", str(int(scale.get_value())))
        self.toast(f"Dock size {int(scale.get_value())} px")

    def _dock_switch(self, switch, _p, key):
        aura_cmd("dock", key, "on" if switch.get_active() else "off")

    def _animations(self, switch, _p):
        ini = os.path.expanduser("~/.config/gtk-3.0/settings.ini")
        os.makedirs(os.path.dirname(ini), exist_ok=True)
        content = ""
        if os.path.isfile(ini):
            with open(ini, encoding="utf-8") as fh:
                content = fh.read()
        lines = [l for l in content.splitlines()
                 if not l.startswith("gtk-enable-animations")]
        if "[Settings]" not in lines:
            lines.insert(0, "[Settings]")
        lines.append(f"gtk-enable-animations={1 if switch.get_active() else 0}")
        with open(ini, "w", encoding="utf-8") as fh:
            fh.write("\n".join(lines) + "\n")
        self.toast("Animation preference saved (new windows)")

    # terminalrc helpers
    def _terminalrc_get(self, key):
        try:
            with open(TERMINALRC, encoding="utf-8") as fh:
                for line in fh:
                    if line.startswith(key + "="):
                        return line.split("=", 1)[1].strip()
        except OSError:
            pass
        return None

    def _terminalrc_set(self, key, value):
        os.makedirs(os.path.dirname(TERMINALRC), exist_ok=True)
        lines = []
        found = False
        if os.path.isfile(TERMINALRC):
            with open(TERMINALRC, encoding="utf-8") as fh:
                lines = fh.read().splitlines()
        for i, line in enumerate(lines):
            if line.startswith(key + "="):
                lines[i] = f"{key}={value}"
                found = True
        if not found:
            if not lines or lines[0] != "[Configuration]":
                lines.insert(0, "[Configuration]")
            lines.append(f"{key}={value}")
        with open(TERMINALRC, "w", encoding="utf-8") as fh:
            fh.write("\n".join(lines) + "\n")
        self.toast("Terminal preference saved")


def main():
    page = sys.argv[1] if len(sys.argv) > 1 else None
    win = Settings(start_page=page)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    sys.exit(main())
