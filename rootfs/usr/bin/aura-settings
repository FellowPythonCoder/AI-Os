            v.pack_start(Gtk.Label(label=title), False, False, 0)
            flow.add(v)
        box.pack_start(flow, False, False, 0)

        grid = Gtk.Grid(column_spacing=12, row_spacing=10)
        grid.attach(Gtk.Label(label="Icon theme:", xalign=0), 0, 0, 1, 1)
        ic_combo = self._theme_combo("/usr/share/icons", "AuraIcons")
        ic_combo.connect("changed", self._icon_theme_changed)
        grid.attach(ic_combo, 1, 0, 1, 1)

        grid.attach(Gtk.Label(label="Cursor theme:", xalign=0), 0, 1, 1, 1)
        cu_combo = self._theme_combo("/usr/share/icons", "AuraCursor")
        cu_combo.connect("changed", self._cursor_theme_changed)
        grid.attach(cu_combo, 1, 1, 1, 1)

        grid.attach(Gtk.Label(label="Cursor size (px):", xalign=0), 0, 2, 1, 1)
        csize = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 16, 48, 4)
        csize.set_value(24)
        csize.set_size_request(220, -1)
        csize.connect(
            "value-changed",
            lambda s: xfconf("xsettings", "/Gtk/CursorThemeSize", "int", int(s.get_value())),
        )
        grid.attach(csize, 1, 2, 1, 1)
        box.pack_start(grid, False, False, 0)
        return box

