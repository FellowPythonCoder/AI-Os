    # ------------------------------------------------------------------ handlers
    def _mode_toggled(self, btn, mode):
        if btn.get_active():
            self.cfg["theme_mode"] = "light" if mode == "light" else "dark"
            save_config(self.cfg)
            aura_cmd("theme", mode)
            self.preview_area.queue_draw()
            self.toast(f"{mode.capitalize()} appearance applied")

    def _accent_clicked(self, _b, name, label, hexv):
        self.cfg["accent"] = name
        self.cfg["accent_hex"] = hexv
        save_config(self.cfg)
        aura_cmd("theme", "accent", name)
        self.preview_area.queue_draw()
        self.toast(f"Accent: {label} ({hexv})")

    def _custom_accent(self, _b):
        rgba = self.color_btn.get_rgba()
        hexv = "#%02x%02x%02x" % (
            int(rgba.red * 255),
            int(rgba.green * 255),
            int(rgba.blue * 255),
        )
        self.cfg["accent"] = "custom"
        self.cfg["accent_hex"] = hexv
        save_config(self.cfg)
        aura_cmd("theme", "accent", hexv)
        self.preview_area.queue_draw()
        self.toast(f"Custom accent: {hexv}")

    def _set_glass_preset(self, _b, preset):
        self.cfg["glass_preset"] = preset
        self.cfg["performance_mode"] = preset == "performance"
        self.cfg["glass_opacity"] = {"glass": 0.78, "frosted": 0.88, "performance": 0.96}[preset]
        save_config(self.cfg)
        aura_cmd("glass", preset)
        self.preview_area.queue_draw()
        self.toast(f"Liquid Glass preset: {preset}")

    def _on_glass_opacity(self, scale):
        val = round(scale.get_value(), 2)
        self.cfg["glass_opacity"] = val
        save_config(self.cfg)
        aura_cmd("glass", "opacity", f"{val:.2f}")
        self.preview_area.queue_draw()

    def _on_blur_intensity(self, scale):
        val = int(scale.get_value())
        self.cfg["blur_intensity"] = val
        save_config(self.cfg)
        aura_cmd("glass", "blur", str(val))
        self.preview_area.queue_draw()

    def _on_shadow_depth(self, scale):
        val = int(scale.get_value())
        self.cfg["shadow_opacity"] = val
        save_config(self.cfg)
        xfconf("xfwm4", "/general/shadow_opacity", "int", val)

    def _lock_wp_changed(self, combo):
        fn = combo.get_active_text()
        if fn:
            self.cfg["lock_wallpaper"] = fn
            save_config(self.cfg)
            self.toast(f"Lock screen wallpaper: {fn}")

    def _lock_toggle(self, switch, _p, key):
        self.cfg[key] = bool(switch.get_active())
        save_config(self.cfg)
        self.toast("Lock screen preference saved")

    def _apply_resolution(self, combo):
        res = combo.get_active_text()
        if not res or not shutil.which("xrandr"):
            return
        r = subprocess.run(["xrandr", "--query"], capture_output=True, text=True)
        for line in r.stdout.splitlines():
            if " connected" in line:
                out = line.split()[0]
                subprocess.Popen(
                    ["xrandr", "--output", out, "--mode", res],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                )
                self.toast(f"Requested resolution {res} on {out}")
                break

    def _apply_brightness(self, scale):
        if not shutil.which("xrandr"):
            return
        r = subprocess.run(["xrandr", "--query"], capture_output=True, text=True)
        for line in r.stdout.splitlines():
            if " connected" in line:
                out = line.split()[0]
                subprocess.Popen(
                    ["xrandr", "--output", out, "--brightness", f"{scale.get_value() / 100.0:.2f}"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                )
                break

    def _theme_combo(self, base, preferred):
        combo = Gtk.ComboBoxText()
        names = []
        if os.path.isdir(base):
            for d in sorted(os.listdir(base)):
                if os.path.isfile(os.path.join(base, d, "index.theme")):
                    names.append(d)
        if preferred not in names:
            names.insert(0, preferred)
        for n in names:
            combo.append_text(n)
        combo.set_active(names.index(preferred))
        return combo

    def _icon_theme_changed(self, combo):
        name = combo.get_active_text()
        if name:
            xfconf("xsettings", "/Net/IconThemeName", "string", name)
            self.toast(f"Icons: {name}")

    def _cursor_theme_changed(self, combo):
        name = combo.get_active_text()
        if name:
            xfconf("xsettings", "/Gtk/CursorThemeName", "string", name)
            self.toast(f"Cursor: {name}")

    def _scaling(self, scale):
        dpi = int(round(96 * scale.get_value()))
        xfconf("xsettings", "/Xft/DPI", "int", str(dpi))
        self.toast(f"Text scaling ≈ {scale.get_value():.1f}× ({dpi} DPI)")

    def _wallpaper_clicked(self, _b, filename):
        aura_cmd("wallpaper", "set", os.path.splitext(filename)[0])
        self.toast("Wallpaper updated")

    def _choose_wallpaper(self, _b):
        dlg = Gtk.FileChooserDialog(
            title="Choose wallpaper",
            transient_for=self,
            action=Gtk.FileChooserAction.OPEN,
        )
        dlg.add_buttons(
            "Cancel", Gtk.ResponseType.CANCEL,
            "Set Wallpaper", Gtk.ResponseType.OK,
        )
        if dlg.run() == Gtk.ResponseType.OK:
            aura_cmd("wallpaper", "set", dlg.get_filename())
            self.toast("Wallpaper updated")
        dlg.destroy()

    def _dock_switch(self, switch, _p, key):
        aura_cmd("dock", key, "on" if switch.get_active() else "off")

    def _animations(self, switch, _p):
        self.cfg["animations"] = bool(switch.get_active())
        save_config(self.cfg)
        ini = os.path.expanduser("~/.config/gtk-3.0/settings.ini")
        os.makedirs(os.path.dirname(ini), exist_ok=True)
        content = ""
        if os.path.isfile(ini):
            with open(ini, encoding="utf-8") as fh:
                content = fh.read()
        lines = [
            l for l in content.splitlines()
            if not l.startswith("gtk-enable-animations")
        ]
        if "[Settings]" not in lines:
            lines.insert(0, "[Settings]")
        lines.append(f"gtk-enable-animations={1 if switch.get_active() else 0}")
        with open(ini, "w", encoding="utf-8") as fh:
            fh.write("\n".join(lines) + "\n")
        self.toast("Animation preference saved")

    def _terminalrc_get(self, key):
        try:
            with open(TERMINALRC, encoding="utf-8") as fh:
                for line in fh:
                    if line.startswith(key + "="):
                        return line.split("=", 1)[1].strip()
        except OSError:
            pass
        return None

    def _terminalrc_set(self, key, value):
        os.makedirs(os.path.dirname(TERMINALRC), exist_ok=True)
        lines = []
        found = False
        if os.path.isfile(TERMINALRC):
            with open(TERMINALRC, encoding="utf-8") as fh:
                lines = fh.read().splitlines()
        for i, line in enumerate(lines):
            if line.startswith(key + "="):
                lines[i] = f"{key}={value}"
                found = True
        if not found:
            if not lines or lines[0] != "[Configuration]":
                lines.insert(0, "[Configuration]")
            lines.append(f"{key}={value}")
        with open(TERMINALRC, "w", encoding="utf-8") as fh:
            fh.write("\n".join(lines) + "\n")
        self.toast("Celestia Shell preference saved")


def main():
    page = sys.argv[1] if len(sys.argv) > 1 else None
    win = Settings(start_page=page)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    sys.exit(main())
