            ("aura-appcenter", "App Center"), ("aura-settings", "Settings"),
            ("aura-studio", "Studio"), ("aura-notes", "Notes"),
            ("aura-calendar", "Calendar"), ("aura-monitor", "Monitor"),
            ("aura-photos", "Photos"), ("user-trash", "Trash"),
        ]
        for icon_id, title in showcase:
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            svg_p = os.path.join(ICONS_DIR, icon_id + ".svg")
            if os.path.isfile(svg_p):
                try:
                    pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(svg_p, 52, 52, True)
                    img = Gtk.Image.new_from_pixbuf(pix)
                except Exception:
                    img = Gtk.Image.new_from_icon_name(icon_id, Gtk.IconSize.DIALOG)
            else:
                img = Gtk.Image.new_from_icon_name(icon_id, Gtk.IconSize.DIALOG)
