#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
AURA Settings — AURA Liquid Glass Blue Edition Control Center.

Organized into 12 cohesive sections with an interactive Liquid Glass
Theme Editor and real-time Cairo preview card. Every control applies
immediately via the `aura` CLI, xfconf, gsettings, or xrandr, and persists
in ~/.config/aura/config.json.
"""
import json
import math
import os
import shutil
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GdkPixbuf, GLib  # noqa: E402

CONFIG_FILE = os.path.expanduser(
    os.environ.get("AURA_CONFIG_FILE", "~/.config/aura/config.json")
)
WP_DIR = "/usr/share/backgrounds/aura"
if not os.path.isdir(WP_DIR):
    WP_DIR = os.path.normpath(
        os.path.join(
            os.path.dirname(os.path.abspath(__file__)),
            "..", "share", "backgrounds", "aura",
        )
    )
ICONS_DIR = "/usr/share/icons/AuraIcons/scalable/apps"
if not os.path.isdir(ICONS_DIR):
    ICONS_DIR = os.path.normpath(
        os.path.join(
            os.path.dirname(os.path.abspath(__file__)),
            "..", "share", "icons", "AuraIcons", "scalable", "apps",
        )
    )
TERMINALRC = os.path.expanduser("~/.config/xfce4/terminal/terminalrc")

ACCENTS = [
    ("ocean", "AURA Blue", "#1677FF"),
    ("electric", "Electric Cyan", "#55D6FF"),
    ("glacier", "Glacier", "#38B6E8"),
    ("ice", "Ice Blue", "#BDEBFF"),
    ("midnight", "Deep Ocean", "#0B2345"),
    ("silver", "Crystal Silver", "#C8DCF0"),
    ("teal", "Alpine Teal", "#14B8A6"),
]


def load_config():
    cfg = {
        "theme_mode": "dark",
        "accent": "ocean",
        "accent_hex": "#1677FF",
        "wallpaper": "aura-midnight-peaks.jpg",
        "lock_wallpaper": "aura-lock-peaks.jpg",
        "lock_clock_24h": True,
        "lock_particles": True,
        "lock_widgets": True,
        "lock_idle_minutes": 10,
        "glass_preset": "glass",
        "glass_opacity": 0.78,
        "blur_intensity": 14,
        "window_opacity": 96,
        "shadow_opacity": 60,
        "performance_mode": False,
        "animations": True,
        "dock": {
            "size": 52,
            "position": "bottom",
            "zoom": True,
            "zoom_percent": 145,
            "autohide": False,
            "style": "glass",
            "spacing": 4,
            "margin": 0,
        },
    }
    try:
        with open(CONFIG_FILE, encoding="utf-8") as fh:
            saved = json.load(fh)
        cfg.update({k: v for k, v in saved.items() if k != "dock"})
        if isinstance(saved.get("dock"), dict):
            cfg["dock"].update(saved["dock"])
    except (OSError, json.JSONDecodeError):
        pass
    return cfg


def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
    with open(CONFIG_FILE, "w", encoding="utf-8") as fh:
        json.dump(cfg, fh, indent=2)
        fh.write("\n")


def aura_cmd(*args):
    subprocess.Popen(
        ["aura", *[str(a) for a in args]],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def xfconf(channel, prop, ptype, value):
    if shutil.which("xfconf-query"):
        subprocess.Popen(
            [
                "xfconf-query", "-c", channel, "-p", prop,
                "-t", ptype, "-s", str(value), "--create",
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def markup_title(text, subtitle=""):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    lbl = Gtk.Label()
    lbl.set_markup(f'<span size="x-large" weight="bold">{text}</span>')
    lbl.set_xalign(0)
    box.pack_start(lbl, False, False, 0)
    if subtitle:
        sub = Gtk.Label(label=subtitle)
        sub.set_xalign(0)
        sub.get_style_context().add_class("dim-label")
        box.pack_start(sub, False, False, 0)
    return box


def section(text):
    lbl = Gtk.Label()
    lbl.set_markup(f"<b>{text}</b>")
    lbl.set_xalign(0)
    lbl.set_margin_top(12)
    return lbl


def hex_to_rgb(h):
    h = h.lstrip("#")
    if len(h) != 6:
        return (0.086, 0.467, 1.0)
    return tuple(int(h[i:i + 2], 16) / 255.0 for i in (0, 2, 4))


class Settings(Gtk.Window):
    def __init__(self, start_page=None):
        super().__init__(title="AURA Settings — Liquid Glass Blue Edition")
        self.set_default_size(1060, 680)
        try:
            self.set_icon_name("aura-settings")
        except Exception:
            pass
        self.cfg = load_config()

        header = Gtk.HeaderBar(
            title="AURA Settings",
            subtitle="AURA Liquid Glass Blue Edition · System Preferences",
        )
        header.set_show_close_button(True)
        self.set_titlebar(header)

        qs_btn = Gtk.Button(label="⚡ Quick Settings")
        qs_btn.connect(
            "clicked",
            lambda *_: subprocess.Popen(
                ["aura-quicksettings"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            ),
        )
        header.pack_start(qs_btn)

        lock_btn = Gtk.Button(label="🔒 Lock")
        lock_btn.connect(
            "clicked",
            lambda *_: subprocess.Popen(
                ["aura-lock"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            ),
        )
        header.pack_start(lock_btn)

        self.status = Gtk.Label()
        header.pack_end(self.status)

        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        paned.set_position(250)
        self.add(paned)

        self.sidebar = Gtk.ListBox()
        self.sidebar.connect("row-selected", self.on_page)
        sb = Gtk.ScrolledWindow()
        sb.add(self.sidebar)
        sb.get_style_context().add_class("sidebar")
        paned.add1(sb)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_UP_DOWN)
        sw = Gtk.ScrolledWindow()
        sw.add(self.stack)
        paned.add2(sw)

        # All 12 organized sections required by the Liquid Glass specification
        pages = [
            ("appearance", "🎨  Appearance & Themes", self.page_appearance),
            ("wallpaper", "🏔  Wallpapers & Lock Screen", self.page_wallpaper),
            ("dock", "🧊  Dock & Menu Bar", self.page_dock),
            ("icons", "💎  Icons & Cursor", self.page_icons),
            ("display", "🖥  Display & Resolution", self.page_display),
            ("input", "⌨️  Keyboard & Mouse", self.page_input),
            ("notifications", "🔔  Notifications", self.page_notifications),
            ("security", "🛡  Privacy & Security", self.page_security),
            ("netaudio", "🌐  Network & Audio", self.page_netaudio),
            ("apps", "🚀  Applications & Startup", self.page_apps),
            ("terminal", "🐚  Celestia Shell", self.page_terminal),
            ("system", "⚙️  VM & System Info", self.page_system),
        ]
        self.page_rows = {}
        for pid, title, builder in pages:
            row = Gtk.ListBoxRow()
            lbl = Gtk.Label(label=title)
            lbl.set_xalign(0)
            lbl.set_margin_start(10)
            lbl.set_margin_top(6)
            lbl.set_margin_bottom(6)
            row.add(lbl)
            row.pid = pid
            self.sidebar.add(row)
            self.page_rows[pid] = row
            self.stack.add_named(builder(), pid)

        # Legacy page aliases
        self.page_rows["effects"] = self.page_rows["appearance"]
        self.page_rows["about"] = self.page_rows["system"]

        self.sidebar.show_all()
        target = self.page_rows.get(start_page or "appearance")
        if target:
            self.sidebar.select_row(target)

    # ------------------------------------------------------------------ util
    def toast(self, text):
        self.status.set_text(text)
        GLib.timeout_add(2600, lambda: (self.status.set_text(""), False)[1])

    def on_page(self, _lb, row):
        if row is not None:
            self.stack.set_visible_child_name(row.pid)

    def page_box(self, title, subtitle=""):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_border_width(22)
        box.pack_start(markup_title(title, subtitle), False, False, 0)
        return box

    # ------------------------------------------------------------------ 1. Appearance & Interactive Liquid Glass Editor
    def page_appearance(self):
        box = self.page_box(
            "Appearance & Liquid Glass Theme Editor",
            "Customize translucent blue glass surfaces, blur intensity, accents, and motion.",
        )

        # Live Interactive Liquid Glass Preview Canvas
        self.preview_area = Gtk.DrawingArea()
        self.preview_area.set_size_request(620, 128)
        self.preview_area.connect("draw", self._draw_glass_preview)
        box.pack_start(self.preview_area, False, False, 4)

        box.pack_start(section("Appearance Mode"), False, False, 0)
        modes = Gtk.Box(spacing=12)
        self.radio_dark = Gtk.RadioButton(label="🌙  Dark — Midnight Navy (#071426)")
        self.radio_light = Gtk.RadioButton(
            group=self.radio_dark, label="☀️  Light — Frosted White (#F4F9FF)"
        )
        self.radio_auto = Gtk.RadioButton(
            group=self.radio_dark, label="🌗  Auto — Adaptive Blue Glass"
        )
        for r, mode in (
            (self.radio_dark, "dark"),
            (self.radio_light, "light"),
            (self.radio_auto, "auto"),
        ):
            r.set_active(self.cfg.get("theme_mode", "dark") == mode)
            r.connect("toggled", self._mode_toggled, mode)
            modes.pack_start(r, False, False, 0)
        box.pack_start(modes, False, False, 0)

        box.pack_start(section("AURA Liquid Glass Accent Palette"), False, False, 0)
        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_max_children_per_line(7)
        flow.set_homogeneous(True)
        for name, label, hexv in ACCENTS:
            btn = Gtk.Button()
            btn.set_size_request(56, 52)
            btn.set_tooltip_text(f"{label}  ({hexv})")
            css = Gtk.CssProvider()
            border = (
                "3px solid #F4F9FF"
                if self.cfg.get("accent") == name
                else "1px solid rgba(85,214,255,0.45)"
            )
            css.load_from_data(
                f"button {{ background: {hexv}; background-image: none; "
                f"border-radius: 14px; border: {border}; }}".encode()
            )
            btn.get_style_context().add_provider(
                css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )
            btn.connect("clicked", self._accent_clicked, name, label, hexv)
            wrap = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            wrap.pack_start(btn, False, False, 0)
            cap = Gtk.Label(label=label)
            cap.get_style_context().add_class("dim-label")
            wrap.pack_start(cap, False, False, 0)
            flow.add(wrap)
        box.pack_start(flow, False, False, 0)

        custom = Gtk.Box(spacing=10)
        custom.pack_start(Gtk.Label(label="Custom blue/cyan highlight:"), False, False, 0)
        self.color_btn = Gtk.ColorButton()
        rgba = Gdk.RGBA()
        rgba.parse(self.cfg.get("accent_hex", "#1677FF"))
        self.color_btn.set_rgba(rgba)
        custom.pack_start(self.color_btn, False, False, 0)
        b_apply = Gtk.Button(label="Apply Custom Accent")
        b_apply.connect("clicked", self._custom_accent)
        custom.pack_start(b_apply, False, False, 0)
        box.pack_start(custom, False, False, 0)

        # Interactive Liquid Glass Sliders
        box.pack_start(section("Interactive Liquid Glass Surface Controls"), False, False, 0)
        preset_row = Gtk.Box(spacing=8)
        preset_row.pack_start(Gtk.Label(label="Surface preset:"), False, False, 0)
        for pid, plabel in (
            ("glass", "✨ Full Liquid Glass"),
            ("frosted", "🧊 Frosted Crystal"),
            ("performance", "⚡ Opaque Performance (Low RAM/CPU)"),
        ):
            pb = Gtk.Button(label=plabel)
            pb.connect("clicked", self._set_glass_preset, pid)
            preset_row.pack_start(pb, False, False, 0)
        box.pack_start(preset_row, False, False, 0)

        grid = Gtk.Grid(column_spacing=14, row_spacing=8)
        # 1. Glass Transparency / Opacity
        grid.attach(Gtk.Label(label="Glass panel opacity:", xalign=0), 0, 0, 1, 1)
        opa_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0.55, 0.98, 0.02)
        opa_scale.set_value(float(self.cfg.get("glass_opacity", 0.78)))
        opa_scale.set_size_request(260, -1)
        opa_scale.connect("value-changed", self._on_glass_opacity)
        grid.attach(opa_scale, 1, 0, 1, 1)

        # 2. Blur Intensity
        grid.attach(Gtk.Label(label="Backdrop blur radius (px):", xalign=0), 0, 1, 1, 1)
        blur_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 24, 1)
        blur_scale.set_value(int(self.cfg.get("blur_intensity", 14)))
        blur_scale.set_size_request(260, -1)
        blur_scale.connect("value-changed", self._on_blur_intensity)
        grid.attach(blur_scale, 1, 1, 1, 1)

        # 3. WindowShadow Depth
        grid.attach(Gtk.Label(label="Window elevation shadow (%):", xalign=0), 0, 2, 1, 1)
        sh_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 5)
        sh_scale.set_value(int(self.cfg.get("shadow_opacity", 60)))
        sh_scale.set_size_request(260, -1)
        sh_scale.connect("value-changed", self._on_shadow_depth)
        grid.attach(sh_scale, 1, 2, 1, 1)

        # 4. Inactive Window Opacity
        grid.attach(Gtk.Label(label="Inactive window opacity (%):", xalign=0), 0, 3, 1, 1)
        win_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 70, 100, 2)
        win_scale.set_value(int(self.cfg.get("window_opacity", 96)))
        win_scale.set_size_request(260, -1)
        win_scale.connect(
            "value-changed",
            lambda s: xfconf("xfwm4", "/general/inactive_opacity", "int", int(s.get_value())),
        )
        grid.attach(win_scale, 1, 3, 1, 1)
        box.pack_start(grid, False, False, 0)

        # Animation & Compositor toggles
        box.pack_start(section("Fluid Motion & Compositor"), False, False, 0)
        anim_row = Gtk.Box(spacing=10)
        anim_sw = Gtk.Switch(active=bool(self.cfg.get("animations", True)))
        anim_sw.connect("notify::active", self._animations)
        anim_row.pack_start(anim_sw, False, False, 0)
        anim_row.pack_start(
            Gtk.Label(label="Fluid GTK & window animations (disable for reduced motion)"),
            False, False, 0,
        )
        box.pack_start(anim_row, False, False, 0)

        b_reset = Gtk.Button(label="Restore AURA Liquid Glass Defaults")
        b_reset.set_margin_top(12)
        b_reset.connect(
            "clicked",
            lambda *_: (
                aura_cmd("theme", "reset"),
                self.toast("Restored AURA Liquid Glass defaults"),
            ),
        )
        box.pack_start(b_reset, False, False, 0)
        return box

    def _draw_glass_preview(self, widget, cr):
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()
        # Deep midnight-to-ocean backdrop with mountain silhouette
        cr.set_source_rgb(0.027, 0.078, 0.149)  # #071426
        cr.rectangle(0, 0, w, h)
        cr.fill()
        # Cyan horizon glow
        ar, ag, ab = hex_to_rgb(self.cfg.get("accent_hex", "#1677FF"))
        cr.set_source_rgba(ar, ag, ab, 0.35)
        cr.arc(w * 0.72, h * 0.65, 90, 0, 2 * math.pi)
        cr.fill()
        # Mountain peaks in preview
        cr.set_source_rgba(0.043, 0.137, 0.270, 0.9)
        cr.move_to(0, h)
        cr.line_to(w * 0.28, h * 0.28)
        cr.line_to(w * 0.52, h * 0.78)
        cr.line_to(w * 0.78, h * 0.22)
        cr.line_to(w, h)
        cr.close_path()
        cr.fill()
        # Translucent Liquid Glass Floating Card
        op = float(self.cfg.get("glass_opacity", 0.78))
        is_dark = self.cfg.get("theme_mode", "dark") != "light"
        if is_dark:
            cr.set_source_rgba(0.043, 0.137, 0.270, op)
        else:
            cr.set_source_rgba(0.957, 0.976, 1.0, op)
        cr.rectangle(28, 18, w - 56, h - 36)
        cr.fill()
        # Luminous electric-cyan edge (#55D6FF)
        cr.set_source_rgba(0.333, 0.839, 1.0, 0.65)
        cr.set_line_width(1.5)
        cr.rectangle(28, 18, w - 56, h - 36)
        cr.stroke()
        # Accent pill inside preview
        cr.set_source_rgba(ar, ag, ab, 0.95)
        cr.rectangle(48, 42, 148, 36)
        cr.fill()
        cr.set_source_rgb(0.957, 0.976, 1.0)
        cr.move_to(64, 65)
        cr.show_text(
            f"AURA Liquid Glass  ·  Opacity {int(op * 100)}%  ·  Blur {self.cfg.get('blur_intensity', 14)}px"
        )
        return False

    # ------------------------------------------------------------------ 2. Wallpapers & Lock Screen
    def page_wallpaper(self):
        box = self.page_box(
            "Wallpapers & Lock Screen",
            "Choose coordinated AURA mountain & Liquid Glass scenes and configure session lock.",
        )
        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_max_children_per_line(4)
        flow.set_column_spacing(10)
        flow.set_row_spacing(10)
        files = []
        if os.path.isdir(WP_DIR):
            files = sorted(
                f for f in os.listdir(WP_DIR)
                if f.lower().endswith((".jpg", ".png", ".jpeg"))
            )
        for fn in files:
            path = os.path.join(WP_DIR, fn)
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 175, 102, True)
                img = Gtk.Image.new_from_pixbuf(pix)
            except GLib.Error:
                img = Gtk.Image.new_from_icon_name("aura-photos", Gtk.IconSize.DIALOG)
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            btn = Gtk.Button()
            btn.add(img)
            btn.connect("clicked", self._wallpaper_clicked, fn)
            col.pack_start(btn, False, False, 0)
            name = os.path.splitext(fn)[0].replace("aura-", "").replace("-", " ").title()
            mark = " ●" if fn == self.cfg.get("wallpaper") else ""
            col.pack_start(Gtk.Label(label=name + mark), False, False, 0)
            flow.add(col)
        box.pack_start(flow, False, False, 0)

        b_choose = Gtk.Button(label="Choose Custom Desktop Wallpaper…")
        b_choose.connect("clicked", self._choose_wallpaper)
        box.pack_start(b_choose, False, False, 0)

        # Lock Screen Configuration
        box.pack_start(section("AURA Liquid Glass Lock Screen"), False, False, 0)
        lock_grid = Gtk.Grid(column_spacing=12, row_spacing=8)

        lock_grid.attach(Gtk.Label(label="Lock screen wallpaper:", xalign=0), 0, 0, 1, 1)
        lock_wp = Gtk.ComboBoxText()
        for fn in files:
            lock_wp.append_text(fn)
        cur_lwp = self.cfg.get("lock_wallpaper", "aura-lock-peaks.jpg")
        if cur_lwp in files:
            lock_wp.set_active(files.index(cur_lwp))
        lock_wp.connect("changed", self._lock_wp_changed)
        lock_grid.attach(lock_wp, 1, 0, 1, 1)

        lock_grid.attach(Gtk.Label(label="Automatic idle lock:", xalign=0), 0, 1, 1, 1)
        idle_combo = Gtk.ComboBoxText()
        idle_opts = [("0", "Never"), ("5", "5 minutes"), ("10", "10 minutes"),
                     ("15", "15 minutes"), ("30", "30 minutes")]
        cur_idle = str(self.cfg.get("lock_idle_minutes", 10))
        for idx, (val, text) in enumerate(idle_opts):
            idle_combo.append(val, text)
            if val == cur_idle:
                idle_combo.set_active(idx)
        idle_combo.connect(
            "changed",
            lambda c: (
                aura_cmd("lock", "timeout", c.get_active_id() or "10"),
                self.toast("Idle lock timeout updated"),
            ),
        )
        lock_grid.attach(idle_combo, 1, 1, 1, 1)
        box.pack_start(lock_grid, False, False, 0)

        for key, label in (
            ("lock_clock_24h", "Use 24-hour digital clock on lock screen"),
            ("lock_particles", "Animated snow & subtle atmospheric light movement"),
            ("lock_widgets", "Show guest system status pill on lock screen"),
        ):
            r = Gtk.Box(spacing=10)
            sw = Gtk.Switch(active=bool(self.cfg.get(key, True)))
            sw.connect("notify::active", self._lock_toggle, key)
            r.pack_start(sw, False, False, 0)
            r.pack_start(Gtk.Label(label=label), False, False, 0)
            box.pack_start(r, False, False, 0)

        b_lock_now = Gtk.Button(label="🔒  Lock Screen Now (Super + L)")
        b_lock_now.get_style_context().add_class("suggested-action")
        b_lock_now.connect(
            "clicked",
            lambda *_: subprocess.Popen(
                ["aura-lock"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
            ),
        )
        box.pack_start(b_lock_now, False, False, 0)
        return box

    # ------------------------------------------------------------------ 3. Dock & Menu Bar
    def page_dock(self):
        box = self.page_box(
            "AURA Dock & Top Menu Bar",
            "Configure the floating Liquid Glass dock shelf and top menu bar.",
        )
        dock = self.cfg["dock"]

        grid = Gtk.Grid(column_spacing=14, row_spacing=10)
        grid.attach(Gtk.Label(label="Dock icon size (px):", xalign=0), 0, 0, 1, 1)
        size = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 32, 96, 2)
        size.set_value(dock.get("size", 52))
        size.set_size_request(260, -1)
        size.connect("value-changed", lambda s: aura_cmd("dock", "size", int(s.get_value())))
        grid.attach(size, 1, 0, 1, 1)

        grid.attach(Gtk.Label(label="Hover magnification (%):", xalign=0), 0, 1, 1, 1)
        zscale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 100, 200, 5)
        zscale.set_value(dock.get("zoom_percent", 145))
        zscale.set_size_request(260, -1)
        zscale.connect(
            "value-changed",
            lambda s: aura_cmd("dock", "zoom-percent", int(s.get_value())),
        )
        grid.attach(zscale, 1, 1, 1, 1)

        grid.attach(Gtk.Label(label="Icon spacing (px):", xalign=0), 0, 2, 1, 1)
        sp_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 12, 1)
        sp_scale.set_value(dock.get("spacing", 4))
        sp_scale.set_size_request(260, -1)
        sp_scale.connect(
            "value-changed",
            lambda s: aura_cmd("dock", "spacing", int(s.get_value())),
        )
        grid.attach(sp_scale, 1, 2, 1, 1)

        grid.attach(Gtk.Label(label="Screen offset / margin:", xalign=0), 0, 3, 1, 1)
        mg_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, -50, 50, 2)
        mg_scale.set_value(dock.get("margin", 0))
        mg_scale.set_size_request(260, -1)
        mg_scale.connect(
            "value-changed",
            lambda s: aura_cmd("dock", "margin", int(s.get_value())),
        )
        grid.attach(mg_scale, 1, 3, 1, 1)

        grid.attach(Gtk.Label(label="Dock position:", xalign=0), 0, 4, 1, 1)
        pos = Gtk.ComboBoxText()
        for p in ("bottom", "left", "right", "top"):
            pos.append_text(p)
        pos.set_active(("bottom", "left", "right", "top").index(dock.get("position", "bottom")))
        pos.connect(
            "changed",
            lambda c: aura_cmd("dock", "position", c.get_active_text()),
        )
        grid.attach(pos, 1, 4, 1, 1)

        grid.attach(Gtk.Label(label="Dock glass material:", xalign=0), 0, 5, 1, 1)
        style_c = Gtk.ComboBoxText()
        for st in ("glass", "frosted", "opaque"):
            style_c.append_text(st)
        cur_st = dock.get("style", "glass")
        style_c.set_active(("glass", "frosted", "opaque").index(cur_st if cur_st in ("glass", "frosted", "opaque") else "glass"))
        style_c.connect(
            "changed",
            lambda c: aura_cmd("dock", "style", c.get_active_text()),
        )
        grid.attach(style_c, 1, 5, 1, 1)
        box.pack_start(grid, False, False, 0)

        for label, key in (
            ("Smooth icon magnification on hover", "zoom"),
            ("Auto-hide dock when windows overlap", "autohide"),
        ):
            row = Gtk.Box(spacing=10)
            sw = Gtk.Switch(active=bool(dock.get(key)))
            sw.connect("notify::active", self._dock_switch, key)
            row.pack_start(sw, False, False, 0)
            row.pack_start(Gtk.Label(label=label), False, False, 0)
            box.pack_start(row, False, False, 0)

        box.pack_start(section("Top Menu Bar"), False, False, 0)
        panel_size = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 26, 44, 1)
        panel_size.set_value(32)
        panel_size.set_size_request(260, -1)
        panel_size.connect(
            "value-changed",
            lambda s: xfconf("xfce4-panel", "/panels/panel-1/size", "uint", int(s.get_value())),
        )
        box.pack_start(panel_size, False, False, 0)
        return box

    # ------------------------------------------------------------------ 4. Icons & Cursor
    def page_icons(self):
        box = self.page_box(
            "Icons & Cursor",
            "3D-inspired AURA Liquid Glass squircle icons and electric-cyan cursor theme.",
        )
        box.pack_start(section("Redesigned AURA Liquid Glass Icon Suite"), False, False, 0)
        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_max_children_per_line(6)
        showcase = [
            ("aura-logo", "AURA OS"), ("aura-finder", "Finder"),
