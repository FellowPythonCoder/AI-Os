#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
aura-quicksettings — AURA OS Liquid Glass Quick Settings & Control Center.

A floating translucent blue-glass panel anchored near the top-right menu bar
providing instant controls for:
- Connectivity (NetworkManager status & connection editor)
- Appearance (Dark / Light mode)
- Liquid Glass intensity (Full Glass / Frosted / Performance mode)
- Do Not Disturb (xfce4-notifyd)
- Audio volume slider & mute (PipeWire / PulseAudio pactl)
- Display brightness slider (xrandr software gamma/brightness for UTM + backlight)
- Quick actions: Lock Screen, Screenshot, System Settings, Power/Session dialog
"""
import json
import os
import re
import shutil
import subprocess
import sys

CONFIG_FILE = os.path.expanduser(
    os.environ.get("AURA_CONFIG_FILE", "~/.config/aura/config.json")
)


def load_config():
    cfg = {
        "theme_mode": "dark",
        "accent": "ocean",
        "glass_preset": "glass",
        "glass_opacity": 0.78,
        "performance_mode": False,
    }
    try:
        with open(CONFIG_FILE, encoding="utf-8") as fh:
            cfg.update(json.load(fh))
    except (OSError, json.JSONDecodeError):
        pass
    return cfg


def net_status() -> str:
    if shutil.which("nmcli"):
        r = subprocess.run(
            ["nmcli", "-t", "-f", "TYPE,STATE,CONNECTION", "dev"],
            capture_output=True, text=True,
        )
        for line in r.stdout.splitlines():
            parts = line.split(":")
            if len(parts) >= 3 and parts[1] == "connected":
                return parts[2] or parts[0]
    try:
        import socket
        socket.create_connection(("1.1.1.1", 53), timeout=1.0).close()
        return "Connected (UTM NAT)"
    except OSError:
        return "Offline"


def current_volume() -> int:
    if shutil.which("pactl"):
        r = subprocess.run(
            ["pactl", "get-sink-volume", "@DEFAULT_SINK@"],
            capture_output=True, text=True,
        )
        m = re.search(r"(\d+)%", r.stdout)
        if m:
            return min(100, int(m.group(1)))
    return 75


def set_volume(pct: int):
    if shutil.which("pactl"):
        subprocess.Popen(
            ["pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{int(pct)}%"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )


def active_xrandr_output() -> str:
    if not shutil.which("xrandr") or not os.environ.get("DISPLAY"):
        return ""
    r = subprocess.run(["xrandr", "--query"], capture_output=True, text=True)
    for line in r.stdout.splitlines():
        if " connected" in line:
            return line.split()[0]
    return ""


def set_brightness(val: float):
    out = active_xrandr_output()
    if out:
        clamped = max(0.35, min(1.0, float(val)))
        subprocess.Popen(
            ["xrandr", "--output", out, "--brightness", f"{clamped:.2f}"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )


def get_dnd() -> bool:
    if not shutil.which("xfconf-query"):
        return False
    r = subprocess.run(
        ["xfconf-query", "-c", "xfce4-notifyd", "-p", "/do-not-disturb"],
        capture_output=True, text=True,
    )
    return r.stdout.strip().lower() == "true"


def set_dnd(val: bool):
    if shutil.which("xfconf-query"):
        subprocess.Popen(
            [
                "xfconf-query", "-c", "xfce4-notifyd", "-p", "/do-not-disturb",
                "-t", "bool", "-s", "true" if val else "false", "--create",
            ],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )


def run_ui():
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gdk  # noqa: E402

    cfg = load_config()

    CSS = b"""
    window.aura-qs-win {
      background-color: rgba(11, 35, 69, 0.90);
      border: 1px solid rgba(85, 214, 255, 0.45);
      border-radius: 18px;
      color: #F4F9FF;
    }
    .aura-qs-header {
      font-weight: 700;
      font-size: 12pt;
      color: #F4F9FF;
    }
    .aura-qs-sub {
      font-size: 9pt;
      color: #BDEBFF;
    }
    """
    prov = Gtk.CssProvider()
    prov.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    win = Gtk.Window(title="AURA Quick Settings")
    win.get_style_context().add_class("aura-qs-win")
    win.set_default_size(360, 410)
    win.set_resizable(False)
    win.set_keep_above(True)
    win.set_type_hint(Gdk.WindowTypeHint.DIALOG)
    # Position near top-right menu bar
    screen = Gdk.Screen.get_default()
    if screen:
        win.move(max(0, screen.get_width() - 380), 40)

    win.connect("key-press-event", lambda w, e: Gtk.main_quit() if e.keyval == Gdk.KEY_Escape else False)

    root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    root.set_border_width(18)
    win.add(root)

    # Top title row
    top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    title = Gtk.Label(label="🏔  AURA Quick Settings")
    title.get_style_context().add_class("aura-qs-header")
    top.pack_start(title, False, False, 0)
    top.pack_start(Gtk.Box(), True, True, 0)
    close_b = Gtk.Button(label="✕")
    close_b.get_style_context().add_class("flat")
    close_b.connect("clicked", lambda *_: Gtk.main_quit())
    top.pack_start(close_b, False, False, 0)
    root.pack_start(top, False, False, 0)

    # 2x2 Quick Toggle Tiles
    grid = Gtk.Grid(column_spacing=10, row_spacing=10, column_homogeneous=True)
    root.pack_start(grid, False, False, 0)

    # 1. Network tile
    net_btn = Gtk.Button(label=f"🌐  Network\n{net_status()}")
    net_btn.get_style_context().add_class("aura-quick-tile-active")
    net_btn.connect(
        "clicked",
        lambda *_: subprocess.Popen(
            ["nm-connection-editor"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        ),
    )
    grid.attach(net_btn, 0, 0, 1, 1)

    # 2. Dark / Light mode tile
    mode_state = {"mode": cfg.get("theme_mode", "dark")}
    mode_btn = Gtk.Button(
        label=f"🌙  Appearance\n{'Dark Glass' if mode_state['mode'] == 'dark' else 'Light Glass'}"
    )
    mode_btn.get_style_context().add_class("aura-quick-tile-active")

    def _toggle_mode(_b):
        mode_state["mode"] = "light" if mode_state["mode"] == "dark" else "dark"
        mode_btn.set_label(
            f"🌙  Appearance\n{'Dark Glass' if mode_state['mode'] == 'dark' else 'Light Glass'}"
        )
        subprocess.Popen(["aura", "theme", mode_state["mode"]])

    mode_btn.connect("clicked", _toggle_mode)
    grid.attach(mode_btn, 1, 0, 1, 1)

    # 3. Liquid Glass preset tile
    presets = ["glass", "frosted", "performance"]
    preset_state = {"idx": presets.index(cfg.get("glass_preset", "glass")) if cfg.get("glass_preset") in presets else 0}
    glass_btn = Gtk.Button(label=f"✨  Liquid Glass\n{presets[preset_state['idx']].capitalize()}")
    glass_btn.get_style_context().add_class("aura-quick-tile")

    def _cycle_glass(_b):
        preset_state["idx"] = (preset_state["idx"] + 1) % len(presets)
        p = presets[preset_state["idx"]]
        glass_btn.set_label(f"✨  Liquid Glass\n{p.capitalize()}")
        subprocess.Popen(["aura", "glass", p])

    glass_btn.connect("clicked", _cycle_glass)
    grid.attach(glass_btn, 0, 1, 1, 1)

    # 4. Do Not Disturb tile
    dnd_state = {"on": get_dnd()}
    dnd_btn = Gtk.Button(label=f"🔔  Notifications\n{'Do Not Disturb' if dnd_state['on'] else 'Active'}")
    dnd_btn.get_style_context().add_class(
        "aura-quick-tile-active" if dnd_state["on"] else "aura-quick-tile"
    )

    def _toggle_dnd(_b):
        dnd_state["on"] = not dnd_state["on"]
        set_dnd(dnd_state["on"])
        dnd_btn.set_label(f"🔔  Notifications\n{'Do Not Disturb' if dnd_state['on'] else 'Active'}")

    dnd_btn.connect("clicked", _toggle_dnd)
    grid.attach(dnd_btn, 1, 1, 1, 1)

    # Sound Volume Slider
    vol_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
    vol_lbl = Gtk.Label(label="🔊  Sound Volume")
    vol_lbl.set_xalign(0)
    vol_box.pack_start(vol_lbl, False, False, 0)
    vol_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    vol_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 2)
    vol_scale.set_value(current_volume())
    vol_scale.set_draw_value(True)
    vol_scale.connect("value-changed", lambda s: set_volume(int(s.get_value())))
    vol_row.pack_start(vol_scale, True, True, 0)
    mixer_btn = Gtk.Button(label="Mixer")
    mixer_btn.connect(
        "clicked",
        lambda *_: subprocess.Popen(
            ["pavucontrol"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        ),
    )
    vol_row.pack_start(mixer_btn, False, False, 0)
    vol_box.pack_start(vol_row, False, False, 0)
    root.pack_start(vol_box, False, False, 0)

    # Display Brightness Slider
    br_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
    br_lbl = Gtk.Label(label="☀️  Display Brightness")
    br_lbl.set_xalign(0)
    br_box.pack_start(br_lbl, False, False, 0)
    br_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 40, 100, 5)
    br_scale.set_value(100)
    br_scale.connect("value-changed", lambda s: set_brightness(s.get_value() / 100.0))
    br_box.pack_start(br_scale, False, False, 0)
    root.pack_start(br_box, False, False, 0)

    # Bottom Action Bar
    actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    actions.set_homogeneous(True)
    for label, cmd in (
        ("🔒 Lock", ["aura-lock"]),
        ("📸 Shot", ["xfce4-screenshooter"]),
        ("⚙ Settings", ["aura-settings"]),
        ("⏻ Power", ["xfce4-session-logout"]),
    ):
        b = Gtk.Button(label=label)
        b.connect(
            "clicked",
            lambda _b, c=cmd: (
                subprocess.Popen(c, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL),
                Gtk.main_quit(),
            ),
        )
        actions.pack_start(b, True, True, 0)
    root.pack_start(actions, False, False, 0)

    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
    return 0


def main():
    if "--dry-run" in sys.argv:
        print("[dry-run] aura-quicksettings")
        return 0
    if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY"):
        print("aura-quicksettings: no graphical display found.", file=sys.stderr)
        return 1
    return run_ui()


if __name__ == "__main__":
    sys.exit(main())
