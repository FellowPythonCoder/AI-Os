#!/usr/bin/env python3
"""AURA Help — searchable in-OS documentation (Markdown topics in /usr/share/aura/help)."""
import glob
import os
import re
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Pango  # noqa: E402

HELP_DIRS = ["/usr/share/aura/help",
             os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                           "..", "share", "aura", "help"))]

FALLBACK = ("Welcome", """# Welcome to AURA OS

Open **Celestia Shell** and try `aura help` — or use the topics on the left.
Full documentation lives in /usr/share/aura/help/.""")


def md_to_pango(text):
    out = []
    for line in text.splitlines():
        e = GLib.markup_escape_text(line)
        e = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", e)
        e = re.sub(r"(?<!\*)\*([^*\n]+?)\*(?!\*)", r"<i>\1</i>", e)
        e = re.sub(r"`([^`]+?)`", r"<tt>\1</tt>", e)
        if line.startswith("# "):
            out.append(f'<span size="xx-large" weight="bold">{e[2:]}</span>')
        elif line.startswith("## "):
            out.append(f'\n<span size="large" weight="bold">{e[3:]}</span>')
        elif line.startswith("### "):
            out.append(f'<span weight="bold">{e[4:]}</span>')
        elif line.lstrip().startswith(("- ", "* ")):
            out.append("   •  " + e.lstrip()[2:])
        elif re.match(r"\d+\. ", line):
            out.append("   " + e)
        else:
            out.append(e)
    return "\n".join(out)


class Help(Gtk.Window):
    def __init__(self, start_topic=None):
        super().__init__(title="AURA Help")
        self.set_default_size(980, 640)
        try:
            self.set_icon_name("aura-help")
        except Exception:
            pass
        self.topics = self.load_topics()

        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        paned.set_position(250)
        self.add(paned)

        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        left.set_border_width(8)
        self.search = Gtk.SearchEntry(placeholder_text="Search help…")
        self.search.connect("search-changed", lambda *_: self.refresh())
        left.pack_start(self.search, False, False, 0)
        self.listbox = Gtk.ListBox()
        self.listbox.connect("row-selected", self.on_select)
        sw = Gtk.ScrolledWindow()
        sw.add(self.listbox)
        left.pack_start(sw, True, True, 0)
        b_tut = Gtk.Button(label="▶  Run the Celestia Tutorial")
        b_tut.get_style_context().add_class("suggested-action")
        b_tut.connect("clicked", lambda *_: subprocess.Popen(
            ["xfce4-terminal", "--title=Celestia Tutorial", "-e",
             "celestia-tutorial"]))
        left.pack_start(b_tut, False, False, 0)
        paned.add1(left)

        self.body = Gtk.Label()
        self.body.set_xalign(0)
        self.body.set_yalign(0)
        self.body.set_line_wrap(True)
        self.body.set_line_wrap_mode(Pango.WrapMode.WORD)
        self.body.set_selectable(True)
        self.body.set_margin_start(20)
        self.body.set_margin_end(20)
        self.body.set_margin_top(14)
        self.body.set_margin_bottom(14)
        rsw = Gtk.ScrolledWindow()
        rsw.add(self.body)
        paned.add2(rsw)

        self.refresh()
        idx = 0
        if start_topic:
            for i, (slug, _t, _b) in enumerate(self.topics):
                if start_topic.lower() in slug.lower():
                    idx = i
                    break
        row = self.listbox.get_row_at_index(idx)
        if row:
            self.listbox.select_row(row)

    def load_topics(self):
        topics = []
        for d in HELP_DIRS:
            for path in sorted(glob.glob(os.path.join(d, "*.md"))):
                try:
                    with open(path, encoding="utf-8") as fh:
                        body = fh.read()
                except OSError:
                    continue
                title = next((l.lstrip("# ").strip() for l in body.splitlines()
                              if l.startswith("# ")), os.path.basename(path))
                slug = os.path.splitext(os.path.basename(path))[0]
                topics.append((slug, title, body))
            if topics:
                break
        if not topics:
            topics = [("welcome", FALLBACK[0], FALLBACK[1])]
        return topics

    def refresh(self):
        q = self.search.get_text().lower().strip()
        for child in self.listbox.get_children():
            self.listbox.remove(child)
        first = None
        for slug, title, body in self.topics:
            if q and q not in title.lower() and q not in body.lower():
                continue
            row = Gtk.ListBoxRow()
            lbl = Gtk.Label(label=title)
            lbl.set_xalign(0)
            lbl.set_margin_start(8)
            lbl.set_margin_top(5)
            lbl.set_margin_bottom(5)
            row.add(lbl)
            row.slug = slug
            self.listbox.add(row)
            first = first or row
        self.listbox.show_all()
        if first:
            self.listbox.select_row(first)

    def on_select(self, _lb, row):
        if row is None:
            return
        for slug, _title, body in self.topics:
            if slug == row.slug:
                self.body.set_markup(md_to_pango(body))
                break


def main():
    win = Help(start_topic=sys.argv[1] if len(sys.argv) > 1 else None)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    sys.exit(main())
