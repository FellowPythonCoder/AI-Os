#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
aura-transfer — AURA OS Liquid Glass File Transfer & Download Manager.

Supports resumable HTTP/HTTPS/FTP downloads (via curl -C -) into ~/Downloads,
automatic SHA-256 checksum verification, and quick opening of the shared UTM
directory or ~/Downloads.
"""
import hashlib
import os
import subprocess
import sys
import threading

DOWNLOADS = os.path.expanduser("~/Downloads")


def main():
    if "--dry-run" in sys.argv:
        print("[dry-run] aura-transfer")
        return 0
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, GLib  # noqa: E402

    os.makedirs(DOWNLOADS, exist_ok=True)

    win = Gtk.Window(title="AURA Transfer")
    win.set_default_size(680, 420)
    try:
        win.set_icon_name("aura-transfer")
    except Exception:
        pass

    hb = Gtk.HeaderBar(
        title="AURA Transfer",
        subtitle="Resumable downloads, checksum verifier & UTM folder access",
    )
    hb.set_show_close_button(True)
    win.set_titlebar(hb)

    open_btn = Gtk.Button(label="Open ~/Downloads")
    open_btn.connect(
        "clicked",
        lambda *_: subprocess.Popen(
            ["xdg-open", DOWNLOADS], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        ),
    )
    hb.pack_end(open_btn)

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    box.set_border_width(18)
    win.add(box)

    row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    url_entry = Gtk.Entry()
    url_entry.set_placeholder_text("https://example.org/file.iso or file URL…")
    dl_btn = Gtk.Button(label="Download")
    dl_btn.get_style_context().add_class("suggested-action")
    row.pack_start(url_entry, True, True, 0)
    row.pack_start(dl_btn, False, False, 0)
    box.pack_start(row, False, False, 0)

    prog = Gtk.ProgressBar()
    prog.set_show_text(True)
    prog.set_text("Ready")
    box.pack_start(prog, False, False, 0)

    listbox = Gtk.ListBox()
    sw = Gtk.ScrolledWindow()
    sw.add(listbox)
    box.pack_start(sw, True, True, 0)

    def refresh_files():
        for ch in list(listbox.get_children()):
            listbox.remove(ch)
        try:
            files = sorted(os.listdir(DOWNLOADS))
        except OSError:
            files = []
        for fn in files[:40]:
            full = os.path.join(DOWNLOADS, fn)
            if not os.path.isfile(full):
                continue
            sz = os.path.getsize(full) / (1024 * 1024)
            r = Gtk.ListBoxRow()
            hb_r = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            hb_r.set_border_width(6)
            lbl = Gtk.Label(label=f"{fn}   ({sz:.2f} MB)")
            lbl.set_xalign(0)
            sha_b = Gtk.Button(label="SHA-256")

            def _sha(_b, p=full, l=lbl, n=fn):
                h = hashlib.sha256()
                with open(p, "rb") as f:
                    for chunk in iter(lambda: f.read(65536), b""):
                        h.update(chunk)
                l.set_text(f"{n}   ·   sha256: {h.hexdigest()[:20]}…")

            sha_b.connect("clicked", _sha)
            hb_r.pack_start(lbl, True, True, 0)
            hb_r.pack_start(sha_b, False, False, 0)
            r.add(hb_r)
            listbox.add(r)
        listbox.show_all()

    def start_download(*_):
        url = url_entry.get_text().strip()
        if not url:
            return
        fname = os.path.basename(url.split("?")[0]) or "download.bin"
        dest = os.path.join(DOWNLOADS, fname)
        dl_btn.set_sensitive(False)
        prog.set_text(f"Downloading {fname}…")
        prog.pulse()

        def worker():
            rc = subprocess.call(["curl", "-fL", "-C", "-", "-o", dest, url])
            GLib.idle_add(done, rc, fname)

        def done(rc, name):
            dl_btn.set_sensitive(True)
            if rc == 0:
                prog.set_fraction(1.0)
                prog.set_text(f"✓ Saved {name} to ~/Downloads")
                url_entry.set_text("")
                refresh_files()
            else:
                prog.set_fraction(0.0)
                prog.set_text(f"✗ Download failed (exit {rc})")
            return False

        threading.Thread(target=worker, daemon=True).start()

    dl_btn.connect("clicked", start_download)
    url_entry.connect("activate", start_download)
    refresh_files()

    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
