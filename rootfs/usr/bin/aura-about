#!/usr/bin/env python3
"""About This AURA — version & hardware overview (real data via `aura system`)."""
import json
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib  # noqa: E402


def system_data():
    try:
        out = subprocess.check_output(["aura", "system", "--json"], text=True,
                                      timeout=10)
        return json.loads(out)
    except Exception:
        data = {"os": "AURA OS"}
        try:
            with open("/etc/os-release", encoding="utf-8") as fh:
                for line in fh:
                    if line.startswith("PRETTY_NAME="):
                        data["os"] = line.split("=", 1)[1].strip().strip('"')
        except OSError:
            pass
        return data


def row(grid, r, label, value):
    key = Gtk.Label(label=label)
    key.set_xalign(1.0)
    key.get_style_context().add_class("dim-label")
    val = Gtk.Label(label=str(value) if value else "—")
    val.set_xalign(0.0)
    val.set_selectable(True)
    val.set_line_wrap(True)
    grid.attach(key, 0, r, 1, 1)
    grid.attach(val, 1, r, 1, 1)


def main():
    d = system_data()
    win = Gtk.Window(title="About This AURA")
    win.set_default_size(520, 480)
    win.set_border_width(24)
    win.set_position(Gtk.WindowPosition.CENTER)
    try:
        win.set_icon_name("aura-about")
    except Exception:
        pass

    vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    win.add(vbox)

    logo = Gtk.Image.new_from_icon_name("aura-logo", Gtk.IconSize.DIALOG)
    logo.set_pixel_size(110)
    vbox.pack_start(logo, False, False, 0)

    title = Gtk.Label()
    title.set_markup('<span size="xx-large" weight="bold">AURA OS</span>')
    vbox.pack_start(title, False, False, 0)
    sub = Gtk.Label(label=d.get("os", "AURA OS"))
    sub.get_style_context().add_class("dim-label")
    vbox.pack_start(sub, False, False, 0)

    grid = Gtk.Grid(column_spacing=16, row_spacing=7)
    grid.set_halign(Gtk.Align.CENTER)
    grid.set_margin_top(12)
    rows = [
        ("Processor", f"{d.get('cpu','—')}  ({d.get('cpu_cores','?')} cores)"),
        ("Guest memory", (f"{d.get('ram_total_gib','?')} GiB allocated to this VM"
                          if d.get("ram_total_gib") else "—")),
        ("Disk", (f"{d.get('disk_used_gb','?')} GB used of "
                  f"{d.get('disk_total_gb','?')} GB" if d.get("disk_total_gb") else "—")),
        ("Kernel", d.get("kernel", "—")),
        ("Architecture", d.get("arch", "—")),
        ("Machine", d.get("virt", "—")),
        ("Based on", d.get("based_on", "Debian GNU/Linux")),
        ("aura CLI", d.get("aura_cli", "—")),
    ]
    for i, (k, v) in enumerate(rows):
        row(grid, i, k, v)
    vbox.pack_start(grid, False, False, 0)

    note = Gtk.Label()
    note.set_markup('<span size="small">Guest memory is the RAM assigned to this '
                    'virtual machine in UTM — it is a portion of your Mac’s '
                    'physical memory.</span>')
    note.set_line_wrap(True)
    note.set_justify(Gtk.Justification.CENTER)
    note.set_margin_top(10)
    vbox.pack_start(note, False, False, 0)

    hbox = Gtk.Box(spacing=8)
    hbox.set_halign(Gtk.Align.CENTER)
    hbox.set_margin_top(14)
    b_settings = Gtk.Button(label="AURA Settings…")
    b_settings.connect("clicked", lambda *_: subprocess.Popen(["aura-settings"]))
    b_help = Gtk.Button(label="AURA Help")
    b_help.connect("clicked", lambda *_: subprocess.Popen(["aura-help"]))
    b_close = Gtk.Button(label="Close")
    b_close.get_style_context().add_class("suggested-action")
    b_close.connect("clicked", lambda *_: win.destroy())
    for b in (b_settings, b_help, b_close):
        hbox.pack_start(b, False, False, 0)
    vbox.pack_start(hbox, False, False, 0)

    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    sys.exit(main())
