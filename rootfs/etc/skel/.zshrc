# AURA OS — personal Zsh configuration.
# Celestia Shell's system defaults live in /etc/celestia/zshrc and are loaded
# first; put your own aliases and settings below that line.
[[ -r /etc/celestia/zshrc ]] && source /etc/celestia/zshrc

