# Calamares branding for AURA OS — see
# https://github.com/calamares/calamares/blob/calamares/src/branding/README.md
---
componentName: aura

welcomeStyleCalamares: false
welcomeExpandingLogo: true

windowExpanding: normal
windowSize: 1020px,640px
sidebar: widget
navigation: widget

strings:
    productName:         "AURA OS"
    shortProductName:    "AURA"
    version:             "1.0"
    shortVersion:        "1.0"
    versionedName:       "AURA OS 1.0 (Aurora Peaks)"
    shortVersionedName:  "AURA 1.0"
    bootloaderEntryName: "AURA OS 1.0"
    productUrl:          "https://github.com/FellowPythonCoder/AI-Os"
    supportUrl:          "https://github.com/FellowPythonCoder/AI-Os/issues"
    knownIssuesUrl:      "https://github.com/FellowPythonCoder/AI-Os/issues"
    releaseNotesUrl:     "https://github.com/FellowPythonCoder/AI-Os/releases"

images:
    productLogo:    "logo.png"
    productIcon:    "logo.png"
    productWelcome: "welcome.png"

slideshow: "show.qml"
slideshowAPI: 2

style:
   sidebarBackground: "#101c33"
   sidebarText: "#e8f1fc"
   sidebarTextSelect: "#ffffff"
   sidebarTextHighlight: "#2f7fe0"
